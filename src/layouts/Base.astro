---
/* src/layouts/Base.astro */
const {
  title = "Maria Klammer – Portfolio",
  bodyClass = "",
  noWrap = false,        // render <slot/> without the centered .wrap
  hideFooter = false,    // hide footer for full-bleed demos
  mainClass = ""         // extra class on <main>
} = Astro.props;

const here = Astro.url.pathname;

// accepts a string or an array of prefixes
const isActive = (hrefs: string | string[]) => {
  const list = Array.isArray(hrefs) ? hrefs : [hrefs];
  return list.some((href) =>
    href === "/"
      ? here === "/"
      : here === href || here.startsWith(href + "/")
  );
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <meta name="robots" content="noindex, nofollow">

    <!-- Instant theme to avoid flash -->
    <script is:inline>
      (function () {
        const KEY = 'theme';
        const saved = localStorage.getItem(KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
<!-- in <head> -->
<style>
  :root { --ui-font: "Inter", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif; }
