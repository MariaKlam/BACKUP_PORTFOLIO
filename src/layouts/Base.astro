</style>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@300..700" rel="stylesheet">
    <slot name="head" />
  </head>

 
