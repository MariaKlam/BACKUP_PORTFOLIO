---
/* src/layouts/Base.astro */

const {
  title = "Maria Klammer – Portfolio",
  bodyClass = "",
  noWrap = false,
  hideFooter = false,
  mainClass = ""
} = Astro.props;

const here = Astro.url.pathname;

const isActive = (hrefs: string | string[]) => {
  const list = Array.isArray(hrefs)
    ? hrefs
    : [hrefs];

  return list.some((href) =>
    href === "/"
      ? here === "/"
      : here === href ||
        here.startsWith(href + "/")
  );
};
---

<html lang="en">

  <head>

    <link
      rel="preload"
      href="/fonts/inter-tight.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <title>{title}</title>

    <link
      rel="stylesheet"
      href="/styles/main.css"
    />
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
/>

<link
  href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;800&display=swap"
  rel="stylesheet"
/>

    <!-- FONTS -->

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
      rel="stylesheet"
    />


    <style>

      :root {
        --ui-font:
          "Inter",
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        --base-bg: #0b0c0f;
        --base-text: #f2f1ec;
      }


      html {
        background: var(--base-bg);
        color-scheme: dark;
      }


      body {
        margin: 0;

        background: var(--base-bg);
        color: var(--base-text);

        font-family: var(--ui-font);
      }



      /* =====================================================
         HEADER
      ====================================================== */

      .site-header {
        position: relative;
        z-index: 100;

        width: 100%;

        border: 0 !important;
        border-bottom: 0 !important;

        background: transparent;

        box-shadow: none !important;
      }


      .header-inner {
        width: 100%;
        max-width: var(--main-max);

        margin-inline: auto;

        padding-inline: var(--gutter);

        display: flex;

        align-items: center;
        justify-content: space-between;

        box-sizing: border-box;
      }



      /* =====================================================
         BRAND
      ====================================================== */

      .brand {
        display: inline-flex;

        align-items: center;

        flex: 0 0 auto;

        color: var(--base-text);

        text-decoration: none !important;

        border: 0 !important;
        outline: 0 !important;

        background: transparent !important;
        box-shadow: none !important;
      }


      .brand:hover,
      .brand:focus,
      .brand:focus-visible {
        border: 0 !important;
        outline: 0 !important;

        background: transparent !important;
        box-shadow: none !important;

        text-decoration: none !important;
      }


      .brand-name {
        font-family:
          "Oswald",
          "Arial Narrow",
          sans-serif;

        font-size: 1.4rem;

        font-weight: 700;

        letter-spacing: .13em;

        text-transform: uppercase;

        line-height: 1;

        white-space: nowrap;

        color: var(--base-text);
      }



      /* =====================================================
         RIGHT
      ====================================================== */

      .header-right {
        margin-left: auto;

        display: flex;

        align-items: center;

        gap: 1.7rem;
      }



      /* =====================================================
         NAV
      ====================================================== */

      .nav {
        display: flex;

        align-items: center;

        gap: 2rem;
      }


      .nav a {
        position: relative;

        display: inline-flex;

        align-items: center;

        min-height: 32px;

        padding: 0 !important;

        font-family:
          "Oswald",
          "Arial Narrow",
          sans-serif;

        font-size: 1.4rem;

        font-weight: 600;

        letter-spacing: .13em;

        line-height: 1;

        text-transform: uppercase;

        text-decoration: none !important;

        color: var(--base-text);

        opacity: .68;

        border: 0 !important;
        border-radius: 0 !important;

        outline: 0 !important;

        background: transparent !important;

        box-shadow: none !important;

        transition:
          opacity .18s ease,
          color .18s ease;
      }


      .nav a:hover {
        opacity: 1;
      }


      .nav a[aria-current="page"] {
        opacity: 1;

        font-weight: 700;

        color: var(--base-text);
      }


      .nav a[aria-current="page"]::before,
      .nav a[aria-current="page"]::after {
        display: none !important;

        content: none !important;
      }



      /* =====================================================
         MOBILE
      ====================================================== */

      @media (max-width: 760px) {

        .header-inner {
          min-height: 68px;

          padding-left: 18px !important;
          padding-right: 18px !important;
        }


        .brand-name {
          font-size: 1.2rem !important;

          letter-spacing: .1em !important;

          font-weight: 700 !important;
        }


        .header-right {
          gap: .85rem;
        }


        .nav {
          gap: 1.15rem !important;
        }


        .nav a {
          font-size: 1.2rem !important;

          letter-spacing: .09em !important;

          font-weight: 700 !important;

          white-space: nowrap;
        }

      }


      @media (max-width: 390px) {

        .brand-name {
          font-size: 1.2rem !important;
        }


        .nav a {
          font-size: 1.2rem !important;
        }


        .nav {
          gap: .9rem !important;
        }

      }



      /* =====================================================
         FOOTER
      ====================================================== */

      .site-footer {
        overflow: hidden;

        background: var(--base-bg);

        color: var(--base-text);
      }


      .bold-ticker {
        width: 100%;

        overflow: hidden;

        padding: 1.3rem 0;
      }


      .bold-ticker__rail {
        display: flex;

        width: max-content;
      }


      .bold-ticker__track span {
        font-family:
          "Oswald",
          "Arial Narrow",
          sans-serif;

        font-size:
          clamp(
            2rem,
            3vw,
            3.5rem
          );

        font-weight: 700;

        line-height: 1;

        letter-spacing: -.02em;

        text-transform: uppercase;

        color: var(--base-text);
      }


      .bold-ticker__track i {
        margin:
          0
          1.5rem;

        font-style: normal;

        opacity: .25;
      }


      @keyframes tickerMove {

        from {
          transform: translateX(0);
        }

        to {
          transform: translateX(-100%);
        }

      }


      .footer-copy {
        padding:
          .8rem
          var(--gutter)
          1rem;

        text-align: center;

        font-size: .72rem;

        color:
          rgba(
            242,
            241,
            236,
            .48
          );
      }


      @media (prefers-reduced-motion: reduce) {

        .bold-ticker__track {
          animation: none;
        }

      }

      :global(body.projects-shell .footer-copy) {
  display: none !important;
}

    </style>


    <slot name="head" />

  </head>



  <body
    class={`menu__container has-thin-sidebar has-double-thin-sidebar menu--sidebar ${bodyClass}`}
    style="--card: var(--bg)"
  >


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="site-header">

      <div class="header-inner">

        <a
          class="brand"
          href="/"
          aria-label="Maria Klammer — Home"
        >

          <span class="brand-name">
            MARIA KLAMMER
          </span>

        </a>


        <div class="header-right">

          <nav
            class="nav"
            aria-label="Primary navigation"
          >

          <a
  href="/projects"
  aria-current={
    isActive([
      "/projects",
      "/case-studies"
    ])
      ? "page"
      : undefined
  }
>
  Projects
</a>


            <a
              href="/contact"
              aria-current={
                isActive("/contact")
                  ? "page"
                  : undefined
              }
            >
              Contact
            </a>

          </nav>

        </div>

      </div>

    </header>



    <!-- =====================================================
         CONTENT
    ====================================================== -->

    {
      noWrap
        ? <slot />
        : (
          <main class={`content ${mainClass}`}>
            <div class="wrap">
              <slot />
            </div>
          </main>
        )
    }



    <!-- =====================================================
         FOOTER
    ====================================================== -->

    {
      !hideFooter &&

      <footer class="site-footer">

        <div
          class="bold-ticker"
          aria-label="Product, design and engineering capabilities"
        >

          <div class="bold-ticker__rail">

            <div class="bold-ticker__track">

              <span>PRODUCT SYSTEMS</span><i>•</i>
              <span>UX/UI</span><i>•</i>
              <span>FRONTEND</span><i>•</i>
              <span>AI WORKFLOWS</span><i>•</i>
              <span>DESIGN SYSTEMS</span><i>•</i>
              <span>BRAND DIRECTION</span><i>•</i>
              <span>API INTEGRATIONS</span><i>•</i>

            </div>


            <div
              class="bold-ticker__track"
              aria-hidden="true"
            >

              <span>PRODUCT SYSTEMS</span><i>•</i>
              <span>UX/UI</span><i>•</i>
              <span>FRONTEND</span><i>•</i>
              <span>AI WORKFLOWS</span><i>•</i>
              <span>DESIGN SYSTEMS</span><i>•</i>
              <span>BRAND DIRECTION</span><i>•</i>
              <span>API INTEGRATIONS</span><i>•</i>

            </div>

          </div>

        </div>


        <div class="footer-copy">
          © {new Date().getFullYear()} Maria Klammer — All rights reserved.
        </div>

      </footer>
    }



    <!-- =====================================================
         COVER CARD EFFECT
    ====================================================== -->

    <script is:inline>

      (() => {

        const cards =
          document.querySelectorAll(
            ".cover-card"
          );


        cards.forEach((el) => {

          el.addEventListener(
            "pointermove",
            (event) => {

              const rect =
                el.getBoundingClientRect();


              el.style.setProperty(
                "--mx",
                `${event.clientX - rect.left}px`
              );


              el.style.setProperty(
                "--my",
                `${event.clientY - rect.top}px`
              );

            }
          );


          el.addEventListener(
            "pointerleave",
            () => {

              el.style.removeProperty("--mx");

              el.style.removeProperty("--my");

            }
          );

        });

      })();

    </script>



    <!-- =====================================================
         CARD REVEAL
    ====================================================== -->

    <script is:inline>

      (() => {

        const elements =
          document.querySelectorAll(
            ".cover-card"
          );


        if (
          !("IntersectionObserver" in window) ||
          !elements.length
        ) {

          elements.forEach((el) =>
            el.classList.add(
              "reveal-in"
            )
          );

          return;
        }


        const observer =
          new IntersectionObserver(

            (entries) => {

              entries.forEach(
                (entry) => {

                  if (
                    entry.isIntersecting
                  ) {

                    entry.target.classList.add(
                      "reveal-in"
                    );


                    observer.unobserve(
                      entry.target
                    );

                  }

                }
              );

            },

            {
              rootMargin:
                "0px 0px -10% 0px",

              threshold:
                0.05
            }

          );


        elements.forEach(
          (el) =>
            observer.observe(el)
        );

      })();

    </script>

  </body>

</html>