---
/* src/layouts/Base.astro */
const {
  title = "Maria Klammer – Portfolio",
  bodyClass = "",
  noWrap = false,        // render <slot/> without the centered .wrap
  hideFooter = false,    // hide footer for full-bleed demos
  mainClass = ""         // extra class on <main>
} = Astro.props;

const here = Astro.url.pathname;

// accepts a string or an array of prefixes
const isActive = (hrefs: string | string[]) => {
  const list = Array.isArray(hrefs) ? hrefs : [hrefs];
  return list.some((href) =>
    href === "/"
      ? here === "/"
      : here === href || here.startsWith(href + "/")
  );
};
