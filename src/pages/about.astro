---
import Base from "../layouts/Base.astro";
---

<Base
  title="About | Maria Klammer"
  bodyClass="about-shell"
  noWrap={true}
>
  <main class="about-page">

    <!-- =====================================================
         HERO
    ====================================================== -->
    <section class="about-hero">
      <div class="about-container about-hero__inner">

        <div class="about-hero__copy">
          <p class="about-kicker">
            PRODUCT ENGINEER · UX/UI · FRONTEND · AI PRODUCTS
          </p>

          <h1 class="about-title">About.</h1>

          <p class="about-lead">
            <strong>Maria Klammer.</strong> I work across product design, UX/UI and frontend development. AI is part of my workflow, helping me explore, prototype and automate. But nothing beats human taste and judgment. I want the final experience to feel clear, intentional and human.
          </p>

          <div class="about-actions">
            <a class="btn-cv about-primary" href="/work">
              Explore selected work
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>

            <a
              class="btn-cv about-secondary"
              href="/cv/Maria_Klammer_cv.pdf"
              target="_blank"
              rel="noopener"
            >
              View CV
            </a>
          </div>
        </div>

      </div>
    </section>


    <!-- =====================================================
         ABOUT CONTENT
    ====================================================== -->
    <section class="about-main">
      <div class="about-container">

        <div class="about-content">

          <div class="about-story">
            <h2>
              I work where product thinking,
              visual systems and frontend meet.
            </h2>

            <div class="about-story__body">
              <p>
                My recent work includes an AI-assisted Email Marketing platform,
                an Instagram content and publishing workflow, ERPLY design-system
                and application work, and product and brand experiences for
                FLAX Hospitality and Isekas self-service checkout.
              </p>

              <p>
                I’m comfortable owning both product logic and interface detail —
                from structuring requirements and user flows to reusable systems,
                API integrations and final frontend implementation.
              </p>

              <p>
                My background in visual communication still shapes how I approach
                hierarchy, clarity, brand and interaction. I don’t separate how
                a product looks from how it actually works.
              </p>
            </div>
          </div>


          <div class="about-details">

            <div class="detail-row">
              <span class="detail-num">01</span>

              <div class="detail-copy">
                <strong>Product</strong>
                <p>
                  Requirements, user flows, interaction design,
                  accessibility and analytics.
                </p>
              </div>
            </div>

            <div class="detail-row">
              <span class="detail-num">02</span>

              <div class="detail-copy">
                <strong>Frontend</strong>
                <p>
                  React, Next.js, TypeScript, JavaScript,
                  HTML, CSS, Go and Astro.
                </p>
              </div>
            </div>

            <div class="detail-row">
              <span class="detail-num">03</span>

              <div class="detail-copy">
                <strong>Systems</strong>
                <p>
                  Design systems, reusable UI, API integrations
                  and automation workflows.
                </p>
              </div>
            </div>

            <div class="detail-row">
              <span class="detail-num">04</span>

              <div class="detail-copy">
                <strong>Visual direction</strong>
                <p>
                  UX/UI, Figma, prototyping, brand systems
                  and product storytelling.
                </p>
              </div>
            </div>

          </div>
        </div>


        <!-- =================================================
             BOTTOM
        ================================================== -->
        <div class="about-bottom">

          <p class="about-background">
            Before product development, I worked across visual communication,
            digital projects and quality-focused software. That background
            still influences how I structure complex systems: clear hierarchy,
            consistent workflows and attention to detail.
          </p>

          <div class="about-bottom__actions">

            <a
              class="btn-cv"
              href="/cv/Maria_Klammer_cv.pdf"
              target="_blank"
              rel="noopener"
            >
              <i
                class="ri-external-link-line"
                aria-hidden="true"
              ></i>
              View CV
            </a>

            <a
              class="btn-cv"
              href="https://www.linkedin.com/in/maria-klammer/"
              target="_blank"
              rel="noopener"
            >
              <i
                class="ri-linkedin-fill"
                aria-hidden="true"
              ></i>
              LinkedIn
            </a>

            <a
              class="btn-cv btn--secondary"
              href="/cv/Maria_Klammer_cv.pdf"
              download
            >
              <i
                class="ri-download-2-line"
                aria-hidden="true"
              ></i>
              Download CV
            </a>

          </div>
        </div>

      </div>
    </section>

  </main>
</Base>


<style>

  /* =========================================================
     SHARED ABOUT GRID

     IMPORTANT:
     Same values that Base/main.css uses for .header-inner.
     No separate 1140px About container anymore.
  ========================================================= */

  .about-container {
    width: 100%;
    max-width: var(--main-max);
    margin-inline: auto;

    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }


  /* =========================================================
     PAGE
  ========================================================= */

  .about-page {
    width: 100%;
    min-width: 0;

    margin: 0;
    padding: 0;
  }


  /* =========================================================
     HERO
  ========================================================= */

  .about-hero {
    width: 100%;

    min-height: clamp(520px, 38vw, 620px);

    background-image:
      linear-gradient(
        90deg,
        rgba(27, 42, 29, .13) 0%,
        rgba(27, 42, 29, .05) 30%,
        rgba(27, 42, 29, 0) 56%
      ),
      url("/images/about/portrait.png");

    background-repeat: no-repeat;
    background-size: cover;

    /*
      portrait.png already has you positioned on the right.
      Keep composition natural instead of moving image via
      weird transforms.
    */
    background-position: center center;

    color: #fff;
  }


  .about-hero__inner {
    min-height: clamp(520px, 38vw, 620px);

    display: flex;
    align-items: center;
  }


  .about-hero__copy {
    /*
      Starts EXACTLY where the header container starts.
      No margin-left / translate / 100vw tricks.
    */
    width: min(620px, 48%);

    margin: 0;
    padding: 0;
  }


  /* =========================================================
     HERO TYPOGRAPHY
  ========================================================= */

  .about-kicker {


        margin: 0 0 .9rem;
    font-family: "Oswald", "Arial Narrow", sans-serif;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .12em;

    text-transform: uppercase;

    color: rgba(255, 255, 255, .96);
  }


  .about-title {
    margin: 0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size: clamp(5rem, 7vw, 7.4rem);
    font-weight: 800;

    line-height: .86;

    letter-spacing: -.065em;

    color: #fff;
  }


  .about-lead {
    max-width: 500px;

    margin: 2rem 0 0;

    font-size: clamp(
      1.2rem,
      1.45vw,
      1.45rem
    );

    line-height: 1.48;

    color: rgba(255, 255, 255, .96);
  }

.about-hero__copy {
  width: min(620px, 48%);
}

.about-lead {
  max-width: 590px;
  font-size: clamp(1.2rem, 1.45vw, 1.45rem);
  line-height: 1.45;
}

  .about-lead strong {
    font-weight: 700;
    color: #fff;
  }


  /* =========================================================
     HERO BUTTONS
  ========================================================= */

  .about-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: .7rem;

    margin-top: 2rem;
  }


  .about-actions .btn-cv {
    display: inline-flex;
    align-items: center;

    gap: .45rem;

    min-height: 40px;

    padding: .62rem 1rem;

    border-radius: 999px;

    font-size: .86rem;
    font-weight: 700;

    text-decoration: none;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font: 600 0.9rem / 1 system-ui, -apple-system, "Inter", "Montserrat", sans-serif;
  }


  .about-primary {
    background: #fff !important;
    border-color: #fff !important;

    color: #0f0f10 !important;
  }


  .about-primary:hover {
    background: rgba(255, 255, 255, .9) !important;
  }


  .about-secondary {
    background: transparent !important;

    border-color:
      rgba(255, 255, 255, .58) !important;

    color: #fff !important;
  }


  .about-secondary:hover {
    background:
      rgba(255, 255, 255, .1) !important;
  }


  /* =========================================================
     MAIN ABOUT AREA
  ========================================================= */

  .about-main {
    width: 100%;

    background: var(--bg);
    color: var(--fg);
  }


  .about-main > .about-container {
    padding-top:
      clamp(4.8rem, 7vw, 7rem);

    padding-bottom:
      clamp(4rem, 7vw, 6rem);
  }


  .about-content {
    display: grid;

    grid-template-columns:
      minmax(0, 1.14fr)
      minmax(330px, .86fr);

    gap:
      clamp(4rem, 8vw, 8rem);

    align-items: start;
  }


  /* =========================================================
     STORY
  ========================================================= */

  .about-story {
    max-width: 700px;
  }


  .about-story h2 {
    max-width: 660px;

    margin: 0 0 2.6rem;

    font-size:
      clamp(2.65rem, 4vw, 4.4rem);

    font-weight: 800;

    line-height: 1;

    letter-spacing: -.05em;
  }


  .about-story__body {
    max-width: 630px;
  }


  .about-story__body p {
    margin:
      0 0 1.25rem;

    font-size: 1rem;

    line-height: 1.7;
  }


  /* =========================================================
     DETAILS
  ========================================================= */

  .about-details {
    width: 100%;

    border-top:
      1px solid var(--border);
  }


  .detail-row {
    display: grid;

    grid-template-columns:
      42px minmax(0, 1fr);

    gap: 1.15rem;

    padding:
      1.45rem 0;

    border-bottom:
      1px solid var(--border);
  }


  .detail-num {
    padding-top: .12rem;

    color: var(--muted);

    font-size: .75rem;
    font-weight: 700;

    letter-spacing: .08em;
  }


  .detail-copy strong {
    display: block;

    margin-bottom: .35rem;

    font-size: 1.06rem;
    font-weight: 700;
  }


  .detail-copy p {
    max-width: 390px;

    margin: 0;

    color: var(--muted);

    line-height: 1.55;
  }


  /* =========================================================
     BOTTOM
  ========================================================= */

  .about-bottom {
    display: grid;

    grid-template-columns:
      minmax(0, 650px)
      auto;

    justify-content: space-between;
    align-items: end;

    gap: 3rem;

    margin-top:
      clamp(4.5rem, 7vw, 7rem);

    padding-top: 2rem;

    border-top:
      1px solid var(--border);
  }


  .about-background {
    margin: 0;

    color: var(--muted);

    line-height: 1.65;
  }


  .about-bottom__actions {
    display: flex;
    flex-wrap: wrap;

    justify-content: flex-end;

    gap: .6rem;
  }


  /* =========================================================
     DARK MODE

     Hero remains photographic / green in both themes.
     Only rest of the page follows normal theme tokens.
  ========================================================= */

  :global(html[data-theme="dark"])
  .about-hero {
    background-image:
      linear-gradient(
        90deg,
        rgba(17, 28, 18, .13) 0%,
        rgba(17, 28, 18, .04) 32%,
        rgba(17, 28, 18, 0) 56%
      ),
      url("/images/about/portrait.png");
  }

  .about-content {
  display: grid;
  grid-template-columns: minmax(0, 560px) minmax(360px, 1fr);
  gap: clamp(5rem, 9vw, 9rem);
  align-items: start;
}

.about-story {
  max-width: 560px;
}

.about-story h2 {
  max-width: 540px;
  margin: 0 0 2.4rem;

  font-size: clamp(2.7rem, 3.6vw, 4rem);
  line-height: 1.02;
  letter-spacing: -.045em;
}

.about-story__body {
  max-width: 540px;
}

.about-details {
  border-top: none;
}

.detail-row {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 1.15rem;

  padding: 1.1rem 0 1.35rem;

  border-bottom: none;
}

.detail-row + .detail-row {
  margin-top: .55rem;
}

.detail-copy p {
  margin: .3rem 0 0;
  max-width: 390px;
  color: var(--muted);
  line-height: 1.5;
}

.detail-num {
  padding-top: .12rem;
  color: var(--muted);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
}


  /* =========================================================
     TABLET
  ========================================================= */

  @media (max-width: 1000px) {

    .about-hero {
      background-position:
        56% center;
    }


    .about-hero__copy {
      width: min(500px, 50%);
    }


    .about-content {
      grid-template-columns:
        1fr;

      gap: 4rem;
    }


    .about-details {
      max-width: 680px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 760px) {

    .about-hero {
      min-height: 760px;

      background-image:
        linear-gradient(
          180deg,
          rgba(23, 36, 24, 0) 20%,
          rgba(23, 36, 24, .08) 46%,
          rgba(23, 36, 24, .72) 100%
        ),
        url("/images/about/portrait.png");

      background-size:
        auto 100%;

      background-position:
        61% top;
    }


    .about-hero__inner {
      min-height: 760px;

      align-items: flex-end;
    }


    .about-hero__copy {
      width: 100%;

      padding-bottom: 3rem;
    }


    .about-title {
      font-size:
        clamp(4.5rem, 19vw, 6.5rem);
    }


    .about-lead {
      max-width: 560px;

      font-size: 1.15rem;
    }


    .about-main > .about-container {
      padding-top: 4rem;
    }


    .about-story h2 {
      font-size:
        clamp(2.6rem, 11vw, 3.6rem);
    }


    .about-bottom {
      grid-template-columns: 1fr;

      align-items: start;

      gap: 2rem;
    }


    .about-bottom__actions {
      justify-content: flex-start;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media (max-width: 480px) {

    .about-hero {
      min-height: 700px;

      background-position:
        60% top;
    }


    .about-hero__inner {
      min-height: 700px;
    }


    .about-kicker {
      font-size: .72rem;
    }


    .about-title {
      font-size:
        clamp(4.25rem, 21vw, 5.5rem);
    }


    .about-lead {
      font-size: 1.08rem;
    }


    .detail-row {
      grid-template-columns:
        32px 1fr;
    }

  }

  @media (max-width: 760px) {
  .about-hero__copy {
    width: 100%;
    padding-bottom: 10rem;
  }

  .about-lead[data-astro-cid-kh7btl4r] {
        max-width: 260px;
  }
}

</style>