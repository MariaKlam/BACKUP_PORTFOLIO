---
import Base from "../layouts/Base.astro";
---

<Base title="Contact | Maria Klammer" bodyClass="contact-shell">
  <section class="contact-page page-spaced-contact">
    <p class="contact-kicker">PRODUCT · DESIGN · CODE</p>

  <h1 class="page-title">Contact.</h1>

    <p class="contact-lead">
  <strong>Maria Klammer</strong> — Product Engineer based in Tallinn.
  Open to frontend, Product/UX and design-engineering opportunities.
</p>

    <p class="contact-note">
      Have a product, interface or messy workflow that needs clarity? Let’s talk.
    </p>

    <div class="contact-stack">
      <p class="icon-text">
        <i class="ri-mail-line" aria-hidden="true"></i>
        <a href="mailto:mariaklammer.est@gmail.com">
          mariaklammer.est@gmail.com
        </a>
      </p>

      <p class="icon-text">
        <i class="ri-map-pin-line" aria-hidden="true"></i>
        <span>Tallinn, Estonia</span>
      </p>
    </div>

    <div class="actions">
      <a
        class="btn-cv"
        href="/cv/Maria_Klammer_cv.pdf"
        target="_blank"
        rel="noopener"
      >
        <i class="ri-external-link-line" aria-hidden="true"></i>
        View CV
      </a>

      <a
        class="btn-cv"
        href="https://www.linkedin.com/in/maria-klammer/"
        target="_blank"
        rel="noopener"
      >
        <i class="ri-linkedin-fill" aria-hidden="true"></i>
        LinkedIn
      </a>

      <a
        class="btn-cv btn--secondary"
        href="/cv/Maria_Klammer_cv.pdf"
        download
      >
        <i class="ri-download-2-line" aria-hidden="true"></i>
        Download CV
      </a>
    </div>
  </section>
</Base>

<style>
  .page-spaced-contact {
    max-width: 760px;
    min-height: min(640px, 70vh);
    padding-top: clamp(3.8rem, 7vw, 6.5rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .contact-kicker {
    margin: 0 0 0.9rem;
    font-family: "Oswald", "Arial Narrow", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-lead {
    max-width: 620px;
    margin: 1.35rem 0 1rem;
    font-size: clamp(1.08rem, 1.7vw, 1.32rem);
    line-height: 1.5;
  }

  .contact-note {
    max-width: 560px;
    margin: 0 0 1.9rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .contact-stack {
    margin-top: 1.4rem;
  }

  .icon-text {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0.65rem 0;
  }

  .icon-text i {
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .icon-text a {
    color: var(--accent);
    text-decoration: none;
  }

  .icon-text a:hover {
    text-decoration: underline;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 2rem;
  }

  @media (max-width: 760px) {
    .page-spaced-contact {
      min-height: auto;
      padding-top: 3rem;
    }

    .contact-lead {
      max-width: 100%;
    }

    .contact-note {
      max-width: 100%;
    }
  }
</style>