<style>

body.dark-mode,
html[data-theme="dark"] {
  --blue-clr: #7ad0ff;
}

:root {
  --blue-clr: rgba(22, 110, 232, 1);
}

.actions { 
  margin-top: 40px;
}

.icon-text {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.25rem 0; /* tighter vertical rhythm */
}

.icon-text i {
  font-size: 1.2rem;
  opacity: 0.85;
  flex-shrink: 0;
}

.icon-text a {
  text-decoration: none;
  color: var(--blue-clr);
}

.icon-text a:hover {
  text-decoration: underline;
}


/* smaller chip variant (reuses your .chip) */
.chip--mini {
  font-size: 12px;
  line-height: 1;
  padding: 6px 10px;
}
/* container: one-line viewport for the ticker */
/* Label spacing under your buttons */
.contact-subtle-label{
  margin: 24px 2px 8px;
  font-size: .8rem;
  opacity: .6;
}

/* Chip look */
.chip{
  font-size:.78rem;
  line-height:1;
  padding:.45rem .6rem;
  border-radius: 999px;
  background: var(--chip-bg, rgba(0,0,0,.06));
  color: inherit;
  opacity: .85;
  white-space: nowrap;
}
.chip--mini{
  font-size: 12px;
  line-height: 1;
  padding: 6px 10px;
}

/* Dark theme tweak */
:root.theme-dark .chip{ background: rgba(255,255,255,.08); opacity:.9; }

/* === Marquee / ticker === */
.skill-ticker{
  --speed: 28s;
  position: relative;
  overflow: hidden;
  height: 34px; /* ≈ one chip row */
  /* nice edge fade */
  -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
          mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
}

/* The rail contains two identical tracks side-by-side */
.skill-rail{
  display: inline-flex;
  align-items: center;
  gap: 8px;                 /* keeps spacing when tracks touch */
  width: max-content;       /* shrink-wrap to content */
  animation: skill-loop var(--speed) linear infinite;
  will-change: transform;
}

/* Each track is a normal horizontal list */
.skill-track{
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
  white-space: nowrap;
}

/* Animate the whole rail, not each UL */
@keyframes skill-loop{
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); } /* exactly one track width */
}

/* Pause on hover/focus for readability */
.skill-ticker:hover .skill-rail,
.skill-ticker:focus-within .skill-rail{
  animation-play-state: paused;
}

/* Motion safety */
@media (prefers-reduced-motion: reduce){
  .skill-rail{ animation: none; }
  .skill-ticker{ -webkit-mask-image: none; mask-image: none; height: auto; }
}

</style>