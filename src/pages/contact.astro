---
import Base from "../layouts/Base.astro";
---

<Base title="Contact | Maria Klammer" bodyClass="contact-shell">
  <section class="contact-page page-spaced-contact">
    <p class="contact-kicker">PRODUCT · DESIGN · CODE</p>
    <h1 class="page-title">Contact.</h1>
    <p class="contact-lead">
      Open to Product Engineer, Frontend, Product/UX and design-engineering opportunities.
    </p>

    <div class="contact-stack">
      <p class="icon-text">
        <i class="ri-mail-line" aria-hidden="true"></i>
        <a href="mailto:mariaklammer.est@gmail.com">mariaklammer.est@gmail.com</a>
      </p>
      <p class="icon-text">
        <i class="ri-map-pin-line" aria-hidden="true"></i>
        <span>Tallinn, Estonia</span>
      </p>
    </div>

    <div class="actions">
      <a class="btn-cv" href="/cv/Maria_Klammer_cv.pdf" target="_blank" rel="noopener">
        <i class="ri-external-link-line" aria-hidden="true"></i> View CV
      </a>
      <a class="btn-cv" href="https://www.linkedin.com/in/maria-klammer/" target="_blank" rel="noopener">
        <i class="ri-linkedin-fill" aria-hidden="true"></i> LinkedIn
      </a>
      <a class="btn-cv btn--secondary" href="/cv/Maria_Klammer_cv.pdf" download>
        <i class="ri-download-2-line" aria-hidden="true"></i> Download CV
      </a>
    </div>
  </section>
</Base>

<style>
  .page-spaced-contact {
    max-width: 760px;
    min-height: min(640px, 70vh);
    padding-top: clamp(3.8rem, 7vw, 6.5rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }
  .contact-kicker {
    margin: 0 0 .9rem;
    font-family: "Oswald", "Arial Narrow", sans-serif;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .12em;
  }
  .contact-lead {
    max-width: 620px;
    font-size: clamp(1.08rem, 1.7vw, 1.32rem);
    line-height: 1.5;
    margin: 1.35rem 0 1.7rem;
  }
  .contact-stack { margin-top: 1.6rem; }
  .icon-text { display:flex; align-items:center; gap:.65rem; margin:.65rem 0; }
  .icon-text i { font-size: 1.2rem; opacity:.8; }
  .icon-text a { color: var(--accent); text-decoration:none; }
  .icon-text a:hover { text-decoration:underline; }
.contact-name {
  font-family: "Oswald", "Arial Narrow", sans-serif;
  font-size: clamp(2rem, 2.4vw, 2.8rem);
  line-height: 1;
  letter-spacing: .01em;
  text-transform: uppercase;
}
.contact-name {
  font-size: clamp(1.9rem, 2.2vw, 2.5rem);
  font-weight: 700;
}
  .actions { margin-top: 2rem; }
  @media (max-width: 760px) {
    .page-spaced-contact { padding-top: 3rem; min-height: auto; }
  }
</style>
