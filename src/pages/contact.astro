<style>

body.dark-mode,
html[data-theme="dark"] {
  --blue-clr: #7ad0ff;
}

:root {
  --blue-clr: rgba(22, 110, 232, 1);
}

.actions { 
  margin-top: 40px;
}

.icon-text {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.25rem 0; /* tighter vertical rhythm */
}

.icon-text i {
  font-size: 1.2rem;
  opacity: 0.85;
  flex-shrink: 0;
}

.icon-text a {
  text-decoration: none;
  color: var(--blue-clr);
}

.icon-text a:hover {
  text-decoration: underline;
}

/* Layout for the icon + ticker row */
.skills-container{
  display: flex;
  align-items: center;
  gap: 12px;
  /* keep this row aligned to your text column, not 50% */
  margin-inline: 0;      /* or auto if you center the column */
  margin-top: 20px;
  max-width: 50%;
}

/* Ticker area fills the rest, can shrink */
.skill-ticker{
  flex: 1 1 auto;
  min-width: 0;          /* allows proper overflow without pushing the svg */
}

/* Mobile: let the row be full width if you want */
@media (max-width: 768px){
  .skills-container{
    max-width: 100%;
  }
}

.signature {
  font-family: var(--font-handwritten, 'Caveat', cursive);
  font-size: 2rem;
  color: var(--blue-clr);
  margin-top: 40px;
  margin-left: 90px;

}

</style>