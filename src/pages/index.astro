---
import Base from "../layouts/Base.astro";
---

<Base
  title="Maria Klammer | Product Engineer · UX/UI · Frontend"
  bodyClass="home-shell"
  noWrap={true}
  hideFooter={true}
>
  <main class="home-page">
    <section class="visual-story" id="visualStory">
      <div class="visual-sticky">

        <!-- =====================================================
             01 — INTRO
        ====================================================== -->

        <section
          class="story-scene story-scene--intro"
          id="sceneIntro"
        >

        <div class="intro-pattern" aria-hidden="true"></div>

          <div class="intro-content">

            <h1 class="intro-title">

              <span
                class="intro-line"
                data-text="Visual instinct."
              >
                <span
                  class="intro-primary"
                  data-text="Visual"
                >
                  Visual
                </span>

                <span
                  class="intro-secondary"
                  data-text="instinct."
                >instinct.
                </span>
              </span>


              <span
                class="intro-line"
                data-text="Engineering depth."
              >
                <span
                  class="intro-primary"
                  data-text="Engineering"
                >
                Engineering
                </span>

                <span
                  class="intro-secondary"
                  data-text="depth."
                >depth.
                </span>
              </span>

            </h1>


           <div class="scroll-cue" aria-hidden="true">
              <span class="scroll-hint">
                Scroll to explore
              </span>

              <span class="scroll-track">
                <span class="scroll-light"></span>
              </span>
            </div>

          </div>
        </section>


        <!-- =====================================================
             02 — KOMPA
        ====================================================== -->

        <section
          class="story-scene"
          id="sceneKompa"
        >
          <div
            class="visual-frame visual-frame--square"
            id="kompaFrame"
          >
            <img
              src="/images/visual/kompa.webp"
              alt="Visual composition study by Maria Klammer"
            />

            <div class="frame-overlay"></div>

            <div class="visual-copy">
              <p class="visual-label">
                <span>01</span>
                <span>Visual thinking</span>
              </p>

              <h2>
                Visual instinct.
              </h2>
            </div>
          </div>
        </section>


        <!-- =====================================================
             03 — STEEL
        ====================================================== -->

        <section
          class="story-scene"
          id="sceneSteel"
        >
          <div
            class="visual-frame visual-frame--landscape"
            id="steelFrame"
          >
            <img
              src="/images/visual/steel-table.png"
              alt="Hospitality visual direction by Maria Klammer"
            />

            <div
              class="frame-overlay frame-overlay--steel"
            ></div>

            <div class="visual-copy">
              <p class="visual-label">
                <span>02</span>
                <span>Direction</span>
              </p>

              <h2>
                Product logic.<br />
                Visual direction.
              </h2>
            </div>
          </div>
        </section>


        <!-- =====================================================
             04 — GIF
        ====================================================== -->

        <section
          class="story-scene"
          id="sceneGif"
        >
          <div
            class="visual-frame visual-frame--square"
            id="gifFrame"
          >
            <img
              src="/images/visual/gif1.gif"
              alt="Interaction and motion study by Maria Klammer"
            />

            <div class="frame-overlay"></div>

            <div class="visual-copy">
              <p class="visual-label">
                <span>03</span>
                <span>Interaction</span>
              </p>

              <h2>
                Systems can<br />
                still feel alive.
              </h2>
            </div>
          </div>
        </section>


        <!-- =====================================================
             05 — FINAL VIDEO
        ====================================================== -->

        <section
          class="story-scene"
          id="sceneFinal"
        >
          <div
            class="visual-frame visual-frame--final"
            id="finalFrame"
          >
            <video
              class="final-video"
              id="finalVideo"
              src="/videos/about-hero.mp4"
              poster="/videos/hero-poster.png"
              muted
              playsinline
              autoplay
              loop
              preload="auto"
              disableRemotePlayback
              aria-hidden="true"
            ></video>

            <div class="final-shade"></div>


            <div
              class="final-content"
              id="finalContent"
            >

              <p class="final-kicker">

                <span class="kicker-desktop">
                  Product Engineer · UX/UI · Frontend · AI Workflows
                </span>

                <span class="kicker-mobile">
                  <span>Product Engineer</span>
                  <span>UX/UI · Frontend</span>
                  <span>AI Workflows</span>
                </span>

              </p>


              <nav
                class="final-icon-links"
                aria-label="Portfolio links"
              >

               <a
                  href="/cv/Maria_Klammer_cv.pdf"
                  target="_blank"
                  rel="noopener"
                  class="final-icon-link"
                  aria-label="View CV"
                >
                  <span
                    class="document-icon"
                    aria-hidden="true"
                  >
                    <span class="document-line"></span>
                    <span class="document-line"></span>
                    <span class="document-line"></span>
                  </span>

                  <span class="icon-label">
                    CV
                  </span>
                </a>

                <a
                  href="/projects"
                  class="final-icon-link"
                  aria-label="View projects"
                >
                  <span
                    class="folder-icon"
                    aria-hidden="true"
                  ></span>

                  <span class="icon-label">
                    Projects
                  </span>
                </a>

              </nav>

            </div>
          </div>
        </section>

      </div>
    </section>
  </main>
</Base>


<script>
  const story =
    document.querySelector("#visualStory");

  const sceneIntro =
    document.querySelector("#sceneIntro");

  const sceneKompa =
    document.querySelector("#sceneKompa");

  const sceneSteel =
    document.querySelector("#sceneSteel");

  const sceneGif =
    document.querySelector("#sceneGif");

  const sceneFinal =
    document.querySelector("#sceneFinal");

  const kompaFrame =
    document.querySelector("#kompaFrame");

  const steelFrame =
    document.querySelector("#steelFrame");

  const gifFrame =
    document.querySelector("#gifFrame");

  const finalFrame =
    document.querySelector("#finalFrame");

  const finalContent =
    document.querySelector("#finalContent");

  const finalVideo =
    document.querySelector("#finalVideo");


  const clamp = (
    value,
    min = 0,
    max = 1
  ) =>
    Math.min(
      Math.max(value, min),
      max
    );


  const range = (
    progress,
    start,
    end
  ) =>
    clamp(
      (progress - start) /
      (end - start)
    );


  const lerp = (
    from,
    to,
    progress
  ) =>
    from +
    (to - from) * progress;


  const viewport = () => ({
    width: window.innerWidth,
    height: window.innerHeight
  });


  const setFrameSize = (
    frame,
    progress,
    startWidth,
    startHeight
  ) => {

    if (!(frame instanceof HTMLElement)) {
      return;
    }

    const {
      width,
      height
    } = viewport();


    const frameWidth =
      lerp(
        startWidth,
        width,
        progress
      );


    const frameHeight =
      lerp(
        startHeight,
        height,
        progress
      );


    frame.style.width =
      `${frameWidth}px`;

    frame.style.height =
      `${frameHeight}px`;


    const radius = 0;


    frame.style.borderRadius =
      `0px`;
  };


  if (
    story instanceof HTMLElement &&
    sceneIntro instanceof HTMLElement &&
    sceneKompa instanceof HTMLElement &&
    sceneSteel instanceof HTMLElement &&
    sceneGif instanceof HTMLElement &&
    sceneFinal instanceof HTMLElement
  ) {

    if (
      finalVideo instanceof HTMLVideoElement
    ) {
      finalVideo.muted = true;
      finalVideo.playsInline = true;

      finalVideo
        .play()
        .catch(() => {});
    }


    const update = () => {

      const rect =
        story.getBoundingClientRect();


      const scrollable =
        story.offsetHeight -
        window.innerHeight;


      const progress =
        scrollable > 0
          ? clamp(
              -rect.top /
              scrollable
            )
          : 0;


      const {
        width,
        height
      } = viewport();


      const isMobile =
        width <= 760;


      const minSide =
        Math.min(
          width,
          height
        );


      /* =====================================================
         INTRO
      ====================================================== */

      const introFade =
        1 -
        range(
          progress,
          .055,
          .12
        );


      sceneIntro.style.opacity =
        String(introFade);



      /* =====================================================
         KOMPA
      ====================================================== */

      const kompaProgress =
        range(
          progress,
          .06,
          .29
        );


      const kompaStart =
        isMobile
          ? minSide * .62
          : minSide * .58;


      setFrameSize(
        kompaFrame,
        kompaProgress,
        kompaStart,
        kompaStart
      );


      sceneKompa.style.opacity =
        progress >= .045
          ? "1"
          : "0";



      /* =====================================================
         STEEL
      ====================================================== */

      const steelProgress =
        range(
          progress,
          .26,
          .49
        );


      const steelStartWidth =
      isMobile
        ? width * .72
        : width * .34;


      const steelStartHeight =
        steelStartWidth * .62;


      setFrameSize(
        steelFrame,
        steelProgress,
        steelStartWidth,
        steelStartHeight
      );


      sceneSteel.style.opacity =
        progress >= .245
          ? "1"
          : "0";



      /* =====================================================
         GIF
      ====================================================== */

      const gifProgress =
        range(
          progress,
          .46,
          .69
        );


      const gifStart =
        isMobile
          ? minSide * .62
          : minSide * .56;


      setFrameSize(
        gifFrame,
        gifProgress,
        gifStart,
        gifStart
      );


      sceneGif.style.opacity =
        progress >= .445
          ? "1"
          : "0";



      /* =====================================================
         FINAL VIDEO
      ====================================================== */

      const finalProgress =
        range(
          progress,
          .66,
          .87
        );


      const finalStartWidth =
        isMobile
          ? width * .68
          : width * .32;


      const finalStartHeight =
        isMobile
          ? finalStartWidth * 1.28
          : finalStartWidth * .62;


      setFrameSize(
        finalFrame,
        finalProgress,
        finalStartWidth,
        finalStartHeight
      );


      sceneFinal.style.opacity =
        progress >= .645
          ? "1"
          : "0";


      sceneFinal.style.pointerEvents =
        progress >= .84
          ? "auto"
          : "none";



      /* =====================================================
         FINAL COPY
      ====================================================== */

      if (
        finalContent instanceof HTMLElement
      ) {

        const copyProgress =
          range(
            progress,
            .82,
            .91
          );


        finalContent.style.opacity =
          String(copyProgress);


        if (isMobile) {

          finalContent.style.transform =
            "none";

        } else {

          finalContent.style.transform =
            `translateY(
              calc(
                -50% +
                ${(1 - copyProgress) * 16}px
              )
            )`;
        }
      }
    };


    update();


    window.addEventListener(
      "scroll",
      update,
      {
        passive: true
      }
    );


    window.addEventListener(
      "resize",
      update
    );
  }
</script>


<style>

  /* =========================================================
     COLORS
  ========================================================= */

  :root {
    --home-bg:
      #111210;

    --home-white:
      #f2f1ec;

    --home-muted:
      rgba(
        242,
        241,
        236,
        .62
      );

    --home-lime:
      #d8f27a;
  }


  /* =========================================================
     PAGE
  ========================================================= */

  :global(html) {
    scroll-behavior:
      smooth;
  }


  .home-page {
    width:
      100%;

    margin:
      0;

    padding:
      0;

    background:
      var(--home-bg);
  }


  /* =========================================================
     STORY
  ========================================================= */

  .visual-story {
    position:
      relative;

    width:
      100%;

    height:
      365svh;

    background:
      var(--home-bg);
  }


  .visual-sticky {
    position:
      sticky;

    top:
      0;

    width:
      100%;

    height:
      100svh;

    overflow:
      hidden;

    isolation:
      isolate;

    background:
      radial-gradient(
        circle at 50% 48%,
        #191a17 0%,
        #111210 70%
      );
  }


  /* =========================================================
     SCENES
  ========================================================= */

  .story-scene {
    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;
  }


  .story-scene--intro {
    z-index:
      10;

    display:
      grid;

    place-items:
      center;
  }


  #sceneKompa {
    z-index:
      20;
  }


  #sceneSteel {
    z-index:
      30;
  }


  #sceneGif {
    z-index:
      40;
  }


  #sceneFinal {
    z-index:
      50;
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .intro-content {
    width:
      min(
        1150px,
        calc(
          100% -
          2 * var(--gutter)
        )
      );

    transform:
      translateY(-18px);

    text-align:
      center;
  }


  .intro-title {
    margin:
      0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      clamp(
        3.8rem,
        6.5vw,
        7rem
      );

    font-weight:
      800;

    line-height:
      .9;

    letter-spacing:
      -.055em;

    text-transform:
      uppercase;

    color:
      var(--home-white);
  }


  /* desktop = exactly two rows */

  .intro-line {
    position:
      relative;

    display:
      block;

    width:
      fit-content;

    margin-inline:
      auto;

    white-space:
      nowrap;
  }


  .intro-primary,
  .intro-secondary {
    position:
      relative;

    display:
      inline-block;

    opacity:
      1;

    filter:
      none;
  }


  .intro-primary {
    color:
      var(--home-white);
  }


  .intro-secondary {
    color:
      var(--home-white);
  }


  /*
    IMPORTANT:
    no individual word glow on desktop.
  */

  .intro-primary::after,
  .intro-secondary::after {
    content:
      none;
  }


  /*
    ONE light beam across each entire row.
  */

  .intro-line::after {
    content:
      attr(data-text);

    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;

    color:
      var(--home-white);

    opacity:
      0;

    filter:
      blur(2.2px)
      brightness(1.55);

    text-shadow:
      0 0 12px
      rgba(
        255,
        255,
        255,
        .26
      ),
      0 0 28px
      rgba(
        255,
        255,
        255,
        .16
      );

    -webkit-mask-image:
      linear-gradient(
        104deg,
        transparent 0%,
        transparent 27%,
        rgba(0,0,0,.1) 36%,
        rgba(0,0,0,.55) 44%,
        #000 50%,
        rgba(0,0,0,.55) 56%,
        rgba(0,0,0,.1) 64%,
        transparent 73%,
        transparent 100%
      );

    mask-image:
      linear-gradient(
        104deg,
        transparent 0%,
        transparent 27%,
        rgba(0,0,0,.1) 36%,
        rgba(0,0,0,.55) 44%,
        #000 50%,
        rgba(0,0,0,.55) 56%,
        rgba(0,0,0,.1) 64%,
        transparent 73%,
        transparent 100%
      );

    -webkit-mask-size:
      280% 100%;

    mask-size:
      280% 100%;

    -webkit-mask-position:
      130% 0;

    mask-position:
      130% 0;

    animation:
      lineLightSweep
      7.8s
      ease-in-out
      infinite;
  }


  .intro-line:nth-child(2)::after {
    animation-delay:
      .45s;
  }


  @keyframes lineLightSweep {

    0%,
    12% {
      -webkit-mask-position:
        130% 0;

      mask-position:
        130% 0;

      opacity:
        0;
    }

    24% {
      opacity:
        .16;
    }

    48% {
      opacity:
        .62;
    }

    72% {
      opacity:
        .30;
    }

    100% {
      -webkit-mask-position:
        -30% 0;

      mask-position:
        -30% 0;

      opacity:
        0;
    }

  }


  .scroll-hint {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      .55rem;

    margin:
      2rem 0 0;

    font-family:
      "Oswald",
      "Arial Narrow",
      sans-serif;

    font-size:
      .86rem;

    font-weight:
      600;

    letter-spacing:
      .14em;

    text-transform:
      uppercase;

    color:
      rgba(
        242,
        241,
        236,
        .50
      );
  }


  .scroll-hint i {
    font-size:
      1rem;
  }


  /* =========================================================
     VISUAL FRAMES
  ========================================================= */

  .visual-frame {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    overflow:
      hidden;

    transform:
      translate(
        -50%,
        -50%
      );

    transform-origin:
      center center;

    will-change:
      width,
      height,
      border-radius;

    background:
      #111;

    border-radius:
      0px;

    box-shadow:
      0 34px 100px
      rgba(
        0,
        0,
        0,
        .34
      );
  }


  .visual-frame > img {
    position:
      absolute;

    inset:
      0;

    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      cover;

    object-position:
      center center;

    user-select:
      none;

    pointer-events:
      none;
  }


  #kompaFrame > img {
    object-position:
      center center;
  }


  #steelFrame > img {
    object-position:
      center center;
  }


  #gifFrame > img {
    object-position:
      center center;
  }


  /* =========================================================
     FRAME OVERLAYS
  ========================================================= */

  .frame-overlay {
    position:
      absolute;

    inset:
      0;

    z-index:
      1;

    pointer-events:
      none;

    background:
      linear-gradient(
        180deg,
        transparent 38%,
        rgba(
          0,
          0,
          0,
          .07
        ) 56%,
        rgba(
          0,
          0,
          0,
          .54
        ) 100%
      );
  }


  .frame-overlay--steel {
    background:
      linear-gradient(
        180deg,
        transparent 40%,
        rgba(
          0,
          0,
          0,
          .10
        ) 62%,
        rgba(
          0,
          0,
          0,
          .55
        ) 100%
      );
  }


  /* =========================================================
     VISUAL COPY
  ========================================================= */

  .visual-copy {
    position:
      absolute;

    z-index:
      2;

    left:
      max(
        3rem,
        4vw
      );

    bottom:
      max(
        2.5rem,
        5vh
      );

    color:
      var(--home-lime);
  }


  .visual-label {
    display:
      flex;

    align-items:
      center;

    gap:
      .65rem;

    margin:
      0 0 .7rem;

    font-family:
      "Oswald",
      "Arial Narrow",
      sans-serif;

    font-size:
      clamp(
        .76rem,
        .85vw,
        .92rem
      );

    font-weight:
      600;

    letter-spacing:
      .15em;

    text-transform:
      uppercase;

    color:
      var(--home-lime);
  }


  .visual-copy h2 {
    margin:
      0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      clamp(
        2.9rem,
        4.7vw,
        5.5rem
      );

    font-weight:
      800;

    line-height:
      .95;

    letter-spacing:
      -.04em;

    color:
      var(--home-lime);

    text-shadow:
      0 2px 24px
      rgba(
        0,
        0,
        0,
        .20
      );
  }


  /* =========================================================
     FINAL VIDEO
  ========================================================= */

  .visual-frame--final {
    background:
      #23382b;
  }


  .final-video {
    position:
      absolute;

    inset:
      0;

    z-index:
      0;

    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      cover;

    object-position:
      center center;
  }


  .final-shade {
    position:
      absolute;

    inset:
      0;

    z-index:
      1;

    pointer-events:
      none;

    background:
      linear-gradient(
        90deg,
        rgba(
          10,
          19,
          13,
          .68
        ) 0%,
        rgba(
          10,
          19,
          13,
          .54
        ) 23%,
        rgba(
          10,
          19,
          13,
          .32
        ) 41%,
        rgba(
          10,
          19,
          13,
          .12
        ) 57%,
        rgba(
          10,
          19,
          13,
          0
        ) 73%
      );
  }


  /* =========================================================
     FINAL CONTENT — DESKTOP
  ========================================================= */

  .final-content {
    position:
      absolute;

    z-index:
      2;

    top:
      50%;

    left:
      max(
        var(--gutter),
        calc(
          (
            100vw -
            var(--main-max)
          ) /
          2 +
          var(--gutter)
        )
      );

    width:
      min(
        680px,
        48vw
      );

    opacity:
      0;

    transform:
      translateY(-50%);

    will-change:
      opacity,
      transform;
  }


  .final-kicker {
    margin:
      0 0 1.8rem;

    font-family:
      "Oswald",
      "Arial Narrow",
      sans-serif;

    font-size:
      1.2rem !important;

    font-weight:
      600;

    line-height:
      1.4;

    letter-spacing:
      .13em;

    text-transform:
      uppercase;

    color:
      var(--home-white);

    animation:
      finalKickerDrift
      7s
      ease-in-out
      infinite;
  }


  .kicker-desktop {
    display:
      inline;
  }


  .kicker-mobile {
    display:
      none;
  }


  /* =========================================================
     FINAL ICON LINKS
  ========================================================= */

  .final-icon-links {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      2rem;

    animation:
      finalLinksDrift
      8s
      ease-in-out
      infinite;
  }


  .final-icon-link {
    display:
      flex;

    flex-direction:
      column;

    align-items:
      center;

    justify-content:
      flex-start;

    gap:
      .65rem;

    color:
      var(--home-lime);

    text-decoration:
      none;

    opacity:
      .92;

    transition:
      opacity .18s ease,
