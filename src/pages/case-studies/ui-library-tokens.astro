---
import Base from "../../layouts/Base.astro";

const title = "UI Library & Token System | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>

  <main class="case-page">

    <!-- ===================================================
         INTRO
    ==================================================== -->

    <section class="case-intro">
      <div class="case-intro__grid">

        <div class="case-meta">
          <span class="case-label">project</span>

          <h1>
            UI Library<br />
            & Token<br />
            System
          </h1>

          <a class="case-back" href="/projects">
            <span class="case-back__arrow">↙</span>
            Projects
          </a>
        </div>


        <div class="case-meta">
          <span class="case-label">bio</span>

          <p class="case-bio">
            A shared design system connecting visual language,
            interaction patterns and frontend implementation
            across multiple products.
          </p>
        </div>


        <div class="case-meta">
          <span class="case-label">deliverables</span>

          <div class="case-deliverables">
            <span>Design system</span>
            <span>Frontend</span>
            <span>Design tokens</span>
            <span>Accessibility</span>
          </div>
        </div>


        <div class="case-meta">
          <span class="case-label">year</span>
          <p class="case-year">2023–2025</p>
        </div>

      </div>
    </section>


    <!-- ===================================================
         HERO
    ==================================================== -->

    <section class="case-media case-media--hero">
      <img
        src="/images/tokens/hero.webp"
        alt="UI Library and token architecture"
      />
    </section>


    <!-- ===================================================
         STATEMENT
    ==================================================== -->

    <section class="case-statement">
      <span class="case-label">system</span>

      <p>
        One visual language.<br />
        One token architecture.<br />
        Multiple products.
      </p>
    </section>


    <!-- ===================================================
         THEMING
    ==================================================== -->

    <section class="case-section">

      <div class="case-section__head">
        <span class="case-label">01 / theming</span>

        <h2>
          Same components.<br />
          Different semantics.
        </h2>

        <p>
          Light and dark themes are driven by semantic tokens rather
          than separate component implementations.
        </p>
      </div>


      <div class="case-grid case-grid--2">

        <figure class="case-figure">
          <img
            src="/images/tokens/dark-theme.webp"
            alt="Dark theme token system"
            loading="lazy"
          />

          <figcaption>
            <strong>Dark theme</strong>
            <span>semantic token mapping</span>
          </figcaption>
        </figure>


        <figure class="case-figure">
          <img
            src="/images/tokens/light-theme-demo.webp"
            alt="Light theme token system"
            loading="lazy"
          />

          <figcaption>
            <strong>Light theme</strong>
            <span>same component architecture</span>
          </figcaption>
        </figure>

      </div>
    </section>


    <!-- ===================================================
         COMPONENT SYSTEM
    ==================================================== -->

    <section class="case-section">

      <div class="case-section__head">
        <span class="case-label">02 / components</span>

        <h2>
          Built for product<br />
          UI at scale.
        </h2>
      </div>


      <figure class="case-figure case-figure--wide">
        <img
          src="/images/tokens/overview.webp"
          alt="Overview of tokenized UI components"
          loading="lazy"
        />

        <figcaption>
          <strong>Component library</strong>
          <span>navigation · forms · feedback · tables · states</span>
        </figcaption>
      </figure>

    </section>


    <!-- ===================================================
         DETAILS GRID
    ==================================================== -->

    <section class="case-section">

      <div class="case-section__head">
        <span class="case-label">03 / interaction</span>

        <h2>
          Patterns instead<br />
          of one-offs.
        </h2>
      </div>


      <div class="case-grid case-grid--2">

        <figure class="case-figure">
          <img
            src="/images/tokens/resource.webp"
            alt="Modal component variants"
            loading="lazy"
          />

          <figcaption>
            <strong>Modal system</strong>
            <span>shared structure · multiple contexts</span>
          </figcaption>
        </figure>


        <figure class="case-figure">
          <img
            src="/images/tokens/thank-you-modal-2.webp"
            alt="Thank-you modal"
            loading="lazy"
          />

          <figcaption>
            <strong>Confirmation states</strong>
            <span>clear feedback and next actions</span>
          </figcaption>
        </figure>


        <figure class="case-figure">
          <img
            src="/images/tokens/flex-table.webp"
            alt="Responsive table patterns"
            loading="lazy"
          />

          <figcaption>
            <strong>Table patterns</strong>
            <span>dense data · responsive behavior</span>
          </figcaption>
        </figure>


        <figure class="case-figure">
          <img
            src="/images/tokens/datepicker.webp"
            alt="Accessible custom datepicker"
            loading="lazy"
          />

          <figcaption>
            <strong>Datepicker</strong>
            <span>keyboard-first interaction</span>
          </figcaption>
        </figure>

      </div>
    </section>


    <!-- ===================================================
         ACCESSIBILITY
    ==================================================== -->

    <section class="case-section">

      <div class="case-section__head">
        <span class="case-label">04 / accessibility</span>

        <h2>
          States belong to<br />
          the system.
        </h2>

        <p>
          Focus, contrast, feedback and disabled states are defined
          centrally rather than recreated product by product.
        </p>
      </div>


      <div class="case-grid case-grid--2">

        <figure class="case-figure">
          <img
            src="/images/tokens/alert-success.webp"
            alt="Accessible success alert"
            loading="lazy"
          />

          <figcaption>
            <strong>System states</strong>
            <span>success · warning · danger · info</span>
          </figcaption>
        </figure>


        <figure class="case-figure">
          <img
            src="/images/tokens/alert-soft.webp"
            alt="Soft alert variants"
            loading="lazy"
          />

          <figcaption>
            <strong>Soft feedback</strong>
            <span>persistent non-blocking messaging</span>
          </figcaption>
        </figure>

      </div>
    </section>


    <!-- ===================================================
         CLOSING IMAGE
    ==================================================== -->

    <section class="case-media case-media--closing">
      <img
        src="/images/tokens/thanks.webp"
        alt="Custom SVG and UI library details"
        loading="lazy"
      />
    </section>


   <!-- ===================================================
     NEXT PROJECT
==================================================== -->

<a
  class="case-next"
  href="/case-studies/dash-case"
>
  <div>
    <span class="case-next__eyebrow">
      next project
    </span>

    <h2 class="case-next__title">
      Dashboard &<br />
      Application<br />
      Patterns
    </h2>
  </div>

  <span
    class="case-next__arrow"
    aria-hidden="true"
  >
    ↗
  </span>
</a>

  </main>


  <style is:global>

    /* =====================================================
       PAGE
    ====================================================== */

    html,
    body {
      background: #0d0f0d !important;
    }

    body {
      color: #f2f1ec;
    }


    .case-page {
      --bg: #0d0f0d;
      --fg: #f2f1ec;
      --muted: rgba(242, 241, 236, .46);
      --line: rgba(242, 241, 236, .13);
      --lime: #d8f27a;

      background: var(--bg);
      color: var(--fg);

      min-height: 100vh;
      padding-top: 1px;
    }


    .case-intro,
    .case-section,
    .case-statement,
    .case-media,
    .case-next {
      width: calc(100% - 80px);
      max-width: 1500px;
      margin-inline: auto;
    }



    /* =====================================================
       INTRO
    ====================================================== */

    .case-intro {
      padding-top: clamp(80px, 1vw, 180px);
      padding-bottom: clamp(90px, 9vw, 130px);
    }


    .case-intro__grid {
      display: grid;

      grid-template-columns:
        1.1fr
        1.6fr
        1.05fr
        .6fr;

      gap: clamp(34px, 4vw, 76px);
      align-items: start;
    }


    .case-label {
      display: block;

      margin-bottom: 18px;

      font-family: "Oswald", "Arial Narrow", sans-serif;

      font-size: 1rem;
      font-weight: 500;

      letter-spacing: .09em;

      color: var(--muted);

      text-transform: lowercase;
    }


    .case-meta h1 {
      margin: 0;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(3rem, 4.4vw, 5.5rem);
      font-weight: 650;

      line-height: .88;

      letter-spacing: -.065em;
    }


    .case-bio {
      margin: 0;

      max-width: 520px;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(1.05rem, 1.4vw, 1.45rem);

      line-height: 1.28;

      letter-spacing: -.025em;
    }


    .case-deliverables {
      display: flex;
      flex-direction: column;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(1.3rem, 1.7vw, 1.8rem);

      line-height: 1.07;

      letter-spacing: -.035em;
    }


    .case-year {
      margin: 0;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    }


    .case-back {
      display: inline-flex;
      align-items: center;

      gap: 11px;

      margin-top: 44px;

      color: var(--fg);

      text-decoration: none;

      font-family: "Inter Tight", sans-serif;

      font-size: .95rem;
      font-weight: 500;
    }


    .case-back__arrow {
      font-size: 2rem;
      font-weight: 300;
    }



    /* =====================================================
       MEDIA
    ====================================================== */

    .case-media img,
    .case-figure img {
      display: block;

      width: 100%;

      object-fit: cover;

      background: #151815;
    }


.case-media--hero {
  max-width: 1280px;
}

.case-media--hero img {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 7.2;
  object-fit: cover;
}


    .case-media--closing {
      margin-top: clamp(120px, 12vw, 180px);
    }


    .case-media--closing img {
      aspect-ratio: 16 / 8.6;
    }



    /* =====================================================
       STATEMENT
    ====================================================== */

    .case-statement {
      padding-top: clamp(130px, 13vw, 190px);
      padding-bottom: clamp(130px, 13vw, 190px);
    }


    .case-statement p {
      margin: 0;

      max-width: 1250px;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(3.3rem, 7vw, 8rem);

      font-weight: 650;

      line-height: .87;

      letter-spacing: -.07em;
    }



    /* =====================================================
       SECTION
    ====================================================== */

    .case-section {
      padding-top: clamp(85px, 9vw, 130px);
    }


    .case-section__head {
      display: grid;

      grid-template-columns: .7fr 1.25fr 1fr;

      gap: clamp(30px, 5vw, 80px);

      margin-bottom: clamp(50px, 6vw, 90px);

      padding-top: 28px;

      border-top: 1px solid var(--line);
    }


    .case-section__head h2 {
      margin: 0;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(2.5rem, 4.5vw, 5.4rem);

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;
    }


    .case-section__head > p {
      margin: 0;

      max-width: 480px;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(1rem, 1.2vw, 1.25rem);

      line-height: 1.4;

      color: rgba(242, 241, 236, .62);
    }



    /* =====================================================
       GRID
    ====================================================== */

    .case-grid {
      display: grid;
    }


    .case-grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: clamp(34px, 4vw, 62px) clamp(22px, 2.5vw, 38px);
    }


    .case-figure {
      margin: 0;
    }


    .case-figure img {
      aspect-ratio: 16 / 9;
    }


    .case-figure--wide img {
      aspect-ratio: 16 / 8.5;
    }


    .case-figure figcaption {
      display: flex;
      align-items: baseline;

      gap: 13px;

      padding-top: 12px;
    }


    .case-figure figcaption strong {
      font-family: "Inter Tight", sans-serif;

      font-size: clamp(1.15rem, 1.55vw, 1.7rem);

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.035em;
    }


    .case-figure figcaption span {
      font-family: "Oswald", "Arial Narrow", sans-serif;

      font-size: 1rem;

      letter-spacing: .06em;

      text-transform: uppercase;

      color: var(--muted);
    }



    /* =====================================================
       NEXT
    ====================================================== */

    .case-next {
      display: flex;

      justify-content: space-between;
      align-items: end;

      gap: 50px;

      margin-top: clamp(130px, 13vw, 190px);

      padding-top: clamp(50px, 6vw, 80px);
      padding-bottom: clamp(90px, 9vw, 130px);

      border-top: 1px solid var(--line);

      color: var(--fg);

      text-decoration: none;
    }


    .case-next__eyebrow {
      display: block;

      margin-bottom: 20px;

      font-family: "Oswald", "Arial Narrow", sans-serif;

      font-size: .8rem;

      letter-spacing: .09em;

      text-transform: uppercase;

      color: var(--muted);
    }


    .case-next__title {
      margin: 0;

      font-family: "Inter Tight", sans-serif;

      font-size: clamp(3.4rem, 6.8vw, 8rem);

      font-weight: 650;

      line-height: .86;

      letter-spacing: -.07em;
    }


    .case-next__arrow {
      color: var(--lime);

      font-size: clamp(5rem, 8vw, 9rem);

      line-height: .7;

      transition: transform .2s ease;
    }


    .case-next:hover .case-next__arrow {
      transform: translate(8px, -8px);
    }



    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1000px) {

      .case-intro__grid {
        grid-template-columns: 1fr 1fr;
      }


      .case-section__head {
        grid-template-columns: 1fr 1.5fr;
      }


      .case-section__head > p {
        grid-column: 2;
      }

    }

    .case-next__arrow {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 68px;
  height: 68px;

  flex: 0 0 68px;

  border: 2px solid var(--lime);
  border-radius: 50%;

  color: var(--lime);

  font-family: Arial, sans-serif;
  font-size: 2.2rem;
  font-weight: 400;
  line-height: 1;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.case-next:hover .case-next__arrow {
  background: var(--lime);
  color: #0d0f0d;

  transform: translate(4px, -4px);
}

@media (max-width: 760px) {
  .case-next__arrow {
    width: 54px;
    height: 54px;
    flex-basis: 54px;

    font-size: 1.8rem;
  }
}

.case-media--closing {
  width: min(100% - 80px, 900px);
  margin: clamp(90px, 10vw, 140px) auto 0;
}

.case-media--closing img {
  width: 100%;
  height: auto;
  aspect-ratio: auto;
  object-fit: contain;
}

/* =====================================================
   MOBILE — MATCH OTHER CASE STUDIES
===================================================== */

html,
body,
.case-page {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}

.case-intro__grid > *,
.case-section__head > *,
.case-grid > * {
  min-width: 0;
}

@media (max-width: 760px) {

  .case-intro,
  .case-section,
  .case-statement,
  .case-media,
  .case-next {
    width: calc(100% - 32px);
    max-width: none;
    margin-left: auto;
    margin-right: auto;
  }

  /* same top start as the other case-study pages */
  .case-intro {
    padding-top: 104px;
    padding-bottom: 72px;
  }

  /* IMPORTANT: 2 x 2 meta layout */
  .case-intro__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: 42px 22px;

    width: 100%;
  }

  .case-meta {
    width: 100%;
    min-width: 0;
  }

  .case-meta h1 {
    margin: 0;

    font-size: clamp(1.8rem, 8.2vw, 2.7rem);
    line-height: .92;
    letter-spacing: -.055em;
  }

  .case-label {
    margin-bottom: 10px;
    font-size: .78rem;
  }

  .case-bio {
    width: 100%;
    max-width: 100%;

    font-size: .95rem;
    line-height: 1.28;

    overflow-wrap: break-word;
  }

  .case-deliverables {
    font-size: 1.08rem;
    line-height: 1.08;
  }

  .case-year {
    font-size: 1.15rem;
  }

  .case-back {
    margin-top: 20px;

    gap: 8px;

    font-size: .9rem;
  }

  .case-back__arrow {
    font-size: 1.65rem;
  }


  /* HERO */

  .case-media--hero {
    width: calc(100% - 32px);
    max-width: none;
  }

  .case-media--hero img {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: auto;
    object-fit: contain;
  }


  /* REST OF PAGE */

  .case-grid--2 {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .case-section__head {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .case-section__head > p {
    grid-column: auto;
  }

  .case-statement {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .case-statement p {
    font-size: clamp(3rem, 13vw, 4.8rem);
  }

  .case-media--closing {
    width: calc(100% - 32px);
    margin-top: 90px;
  }

  .case-next {
    gap: 24px;
  }

  .case-next__title {
    font-size: clamp(3rem, 13vw, 4.8rem);
  }
}
  </style>

</Base>