---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "UI Library & Token System | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            UI Library &<br />
            Token System
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A shared design system connecting visual language,
            interaction patterns and frontend implementation
            across multiple products.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Design system</span>
            <span>Frontend</span>
            <span>Design tokens</span>
            <span>Accessibility</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2023–2025
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media token-hero">
        <img
          src="/images/tokens/hero.webp"
          alt="UI Library and token architecture"
        />
      </figure>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          One visual language.<br />
          One token architecture.<br />

          <span class="case-statement__accent">
            Multiple products.
          </span>
        </p>

      </section>


      <!-- ===================================================
           01 / THEMING
      ==================================================== -->

      <section class="token-section">

        <div class="token-section__head">

          <span class="token-eyebrow">
            01 / theming
          </span>

          <h2>
            Same components.<br />
            Different semantics.
          </h2>

          <p>
            Light and dark themes are driven by semantic tokens
            rather than separate component implementations.
          </p>

        </div>


        <div class="token-grid token-grid--2">

          <figure class="token-card">
            <img
              src="/images/tokens/dark-theme.webp"
              alt="Dark theme token system"
              loading="lazy"
            />

            <figcaption>
              <strong>Dark theme</strong>
              <span>semantic token mapping</span>
            </figcaption>
          </figure>


          <figure class="token-card">
            <img
              src="/images/tokens/light-theme-demo.webp"
              alt="Light theme token system"
              loading="lazy"
            />

            <figcaption>
              <strong>Light theme</strong>
              <span>same component architecture</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           02 / COMPONENT SYSTEM
      ==================================================== -->

      <section class="token-section">

        <div class="token-section__head">

          <span class="token-eyebrow">
            02 / components
          </span>

          <h2>
            Built for product<br />
            UI at scale.
          </h2>

          <p>
            Reusable structures reduce visual drift and make
            application interfaces easier to build and maintain.
          </p>

        </div>


        <figure class="token-card token-card--wide">

          <img
            src="/images/tokens/overview.webp"
            alt="Overview of tokenized UI components"
            loading="lazy"
          />

          <figcaption>
            <strong>Component library</strong>
            <span>
              navigation · forms · feedback · tables · states
            </span>
          </figcaption>

        </figure>

      </section>


      <!-- ===================================================
           03 / INTERACTION
      ==================================================== -->

      <section class="token-section">

        <div class="token-section__head">

          <span class="token-eyebrow">
            03 / interaction
          </span>

          <h2>
            Patterns instead<br />
            of one-offs.
          </h2>

          <p>
            Shared interaction rules make complex application
            behavior more predictable across products.
          </p>

        </div>


        <div class="token-grid token-grid--2">

          <figure class="token-card">

            <img
              src="/images/tokens/resource.webp"
              alt="Modal component variants"
              loading="lazy"
            />

            <figcaption>
              <strong>Modal system</strong>
              <span>shared structure · multiple contexts</span>
            </figcaption>

          </figure>


          <figure class="token-card">

            <img
              src="/images/tokens/thank-you-modal-2.webp"
              alt="Thank-you modal"
              loading="lazy"
            />

            <figcaption>
              <strong>Confirmation states</strong>
              <span>clear feedback and next actions</span>
            </figcaption>

          </figure>


          <figure class="token-card">

            <img
              src="/images/tokens/flex-table.webp"
              alt="Responsive table patterns"
              loading="lazy"
            />

            <figcaption>
              <strong>Table patterns</strong>
              <span>dense data · responsive behavior</span>
            </figcaption>

          </figure>


          <figure class="token-card">

            <img
              src="/images/tokens/datepicker.webp"
              alt="Accessible custom datepicker"
              loading="lazy"
            />

            <figcaption>
              <strong>Datepicker</strong>
              <span>keyboard-first interaction</span>
            </figcaption>

          </figure>

        </div>

      </section>


      <!-- ===================================================
           04 / ACCESSIBILITY
      ==================================================== -->

      <section class="token-section">

        <div class="token-section__head">

          <span class="token-eyebrow">
            04 / accessibility
          </span>

          <h2>
            States belong to<br />
            the system.
          </h2>

          <p>
            Focus, contrast, feedback and disabled states are
            defined centrally rather than recreated product by
            product.
          </p>

        </div>


        <div class="token-grid token-grid--2">

          <figure class="token-card">

            <img
              src="/images/tokens/alert-soft.webp"
              alt="Soft alert variants"
              loading="lazy"
            />

            <figcaption>
              <strong>Soft feedback</strong>
              <span>persistent non-blocking messaging</span>
            </figcaption>

          </figure>


          <figure class="token-card">

            <img
              src="/images/tokens/thanks.webp"
              alt="Custom SVG and UI library details"
              loading="lazy"
            />

            <figcaption>
              <strong>Thank You</strong>
              <span>custom SVG with logo font</span>
            </figcaption>

          </figure>

        </div>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/dash-case"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            Dashboard &<br />
            Application<br />
            Patterns
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>


  <style>

    /* =====================================================
       HERO
    ===================================================== */

    .token-hero {
      width: 100%;
      max-width: 1176px;

      margin-left: auto;
      margin-right: auto;
      margin-bottom: 48px;

      overflow: hidden;
    }


    .token-hero img {
      display: block;

      width: 100%;
      height: auto;

      object-fit: contain;
    }



    /* =====================================================
       SECTIONS
    ===================================================== */

    .token-section {
      width: 100%;
      max-width: 1176px;

      margin-left: auto;
      margin-right: auto;

      padding-bottom: 30px;
    }


    .token-section__head {
      display: grid;

      grid-template-columns:
        .7fr
        1.25fr
        1fr;

      gap:
        clamp(
          30px,
          5vw,
          80px
        );

      align-items: start;

      margin-bottom:
        clamp(
          48px,
          6vw,
          82px
        );

      padding-top: 28px;

      border-top:
        1px solid
        rgba(
          242,
          241,
          236,
          .13
        );
    }


    .token-eyebrow {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;
      font-weight: 500;

      line-height: 1;

      letter-spacing: .09em;

      text-transform: uppercase;

      color:
        rgba(
          242,
          241,
          236,
          .46
        );
    }


    .token-section__head h2 {
      margin: 0;

      font-family:
        "Inter Tight",
        var(--ui-font),
        sans-serif;

      font-size:
        clamp(
          2.4rem,
          4vw,
          4.8rem
        );

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;

      color: #f2f1ec;
    }


    .token-section__head > p {
      margin: 0;

      max-width: 480px;

      font-family:
        "Inter Tight",
        var(--ui-font),
        sans-serif;

      font-size:
        clamp(
          1rem,
          1.15vw,
          1.2rem
        );

      line-height: 1.42;

      letter-spacing: -.02em;

      color:
        rgba(
          242,
          241,
          236,
          .62
        );
    }



    /* =====================================================
       IMAGE GRID
    ===================================================== */

    .token-grid {
      display: grid;

      width: 100%;

      gap:
        clamp(
          34px,
          4vw,
          58px
        )
        clamp(
          20px,
          2.4vw,
          34px
        );
    }


    .token-grid--2 {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }


    .token-card {
      width: 100%;

      min-width: 0;

      margin: 0;
    }


    .token-card img {
      display: block;

      width: 100%;
      height: auto;

      object-fit: contain;

      background: #151815;
    }


    .token-card--wide {
      width: 100%;
    }


    .token-card figcaption {
      display: flex;

      align-items: baseline;

      gap: 13px;

      padding-top: 12px;
    }


    .token-card figcaption strong {
      font-family:
        "Inter Tight",
        var(--ui-font),
        sans-serif;

      font-size:
        clamp(
          1.1rem,
          1.4vw,
          1.5rem
        );

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.035em;

      color: #f2f1ec;
    }


    .token-card figcaption span {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: .9rem;

      letter-spacing: .06em;

      text-transform: uppercase;

      color:
        rgba(
          242,
          241,
          236,
          .46
        );
    }

.token-grid--2 .token-card img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: contain;
}

    /* =====================================================
       TABLET
    ===================================================== */

    @media (max-width: 1000px) {

      .token-section__head {
        grid-template-columns:
          1fr
          1.5fr;
      }


      .token-section__head > p {
        grid-column: 2;
      }

    }



    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 760px) {

      .token-hero,
      .token-section {
        width: 100%;
        max-width: none;

        margin-left: 0;
        margin-right: 0;
      }


      .token-section {
        padding-top: 90px;
      }


      .token-section__head {
        grid-template-columns: 1fr;

        gap: 20px;

        margin-bottom: 38px;

        padding-top: 20px;
      }


      .token-section__head > p {
        grid-column: auto;
      }


      .token-eyebrow {
        font-size: .8rem;
      }


      .token-section__head h2 {
        font-size:
          clamp(
            2.2rem,
            11vw,
            3.5rem
          );
      }


      .token-section__head > p {
        font-size: .95rem;
      }


      .token-grid--2 {
        grid-template-columns: 1fr;
      }


      .token-grid {
        gap: 34px;
      }


      .token-card figcaption {
        flex-direction: column;

        align-items: flex-start;

        gap: 7px;
      }


      .token-card figcaption strong {
        font-size: 1.15rem;
      }


      .token-card figcaption span {
        font-size: .8rem;
      }

    }

  </style>

</Base>