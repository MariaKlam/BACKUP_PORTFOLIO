---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Email Marketing Platform | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">

          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Email Marketing<br />
            Platform
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>

        </div>


        <div class="case-meta__block">

          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            Campaign creation and management product with
            multiple editing flows, AI-assisted workflows,
            automation, analytics and tracking.
          </p>

        </div>


        <div class="case-meta__block">

          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Product design</span>
            <span>Frontend</span>
            <span>AI workflows</span>
            <span>Campaign systems</span>
          </div>

        </div>


        <div class="case-meta__block">

          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2025–2026
          </p>

        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media">

        <img
          src="/images/email-marketing/email-marketing-hero.webp"
          alt="Email Marketing Platform overview"
        />

      </figure>


      <!-- ===================================================
           FIRST VISUAL GRID
           SIGNUP + COLORFUL
      ==================================================== -->

      <section
        class="case-gallery case-gallery--tall-pair"
        aria-label="Email Marketing Platform screens"
      >

        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/signup.webp"
            alt="Email Marketing signup flow"
            loading="lazy"
          />
        </figure>


        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/colorful.webp"
            alt="Colorful email campaign template"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          Built across campaign creation,
          <span class="case-statement__accent">
            AI-assisted editing,
          </span>
          scheduling, tracking and automation.
        </p>

      </section>


      <!-- ===================================================
           LARGE AI VISUAL
      ==================================================== -->

      <section class="case-gallery case-gallery--wide">

        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/ai-example.webp"
            alt="AI-assisted email editing workflow"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           SECOND VISUAL GRID
           SMAILY + WELCOME
      ==================================================== -->

      <section class="case-gallery case-gallery--wide-pair">

        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/smaily.webp"
            alt="Email marketing template"
            loading="lazy"
          />
        </figure>


        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/welcome.webp"
            alt="Email Marketing welcome screen"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           FINAL FULL WIDTH VISUAL
      ==================================================== -->

      <section class="case-gallery case-gallery--wide">

        <figure class="case-gallery__item">
          <img
            src="/images/email-marketing/magnum.webp"
            alt="Email campaign example"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/social-media-generator"
      >

        <div>

          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            AI Social Media<br />
            Generator
          </h2>

        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>


  <style>

    /* =====================================================
       EMAIL MARKETING MEDIA
    ===================================================== */

    .case-hero-media,
    .case-gallery {
      width: 100%;
      max-width: none;

      margin-left: 0;
      margin-right: 0;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .case-hero-media {
      margin-bottom: 48px;
    }

    .case-hero-media img {
      display: block;

      width: 100%;
      height: auto;
    }


    /* =====================================================
       DEFAULT GALLERY
    ===================================================== */

    .case-gallery {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 24px;

      margin-top: 24px;
      margin-bottom: 48px;

      align-items: stretch;
    }


    .case-gallery__item {
      width: 100%;
      margin: 0;

      overflow: hidden;
    }


    .case-gallery__item img {
      display: block;

      width: 100%;
      height: auto;
    }


    /* =====================================================
       FIRST PAIR
       SIGNUP + COLORFUL
    ===================================================== */

    .case-gallery--tall-pair
    .case-gallery__item {
      height:
        clamp(
          360px,
          31vw,
          500px
        );

      overflow: hidden;
    }


    .case-gallery--tall-pair
    .case-gallery__item img {
      width: 100%;
      height: auto;

      object-position:
        top center;
    }


    /* =====================================================
       SECOND PAIR
       SMAILY + WELCOME
    ===================================================== */

    .case-gallery--wide-pair
    .case-gallery__item {
      height:
        clamp(
          280px,
          24vw,
          400px
        );

      overflow: hidden;
    }


    .case-gallery--wide-pair
    .case-gallery__item img {
      width: 100%;
      height: auto;

      object-position:
        top center;
    }


    /* =====================================================
       FULL WIDTH VISUALS
    ===================================================== */

    .case-gallery--wide {
      display: block;
    }


    .case-gallery--wide
    .case-gallery__item {
      width: 100%;
      height: auto;

      overflow: visible;
    }


    .case-gallery--wide
    .case-gallery__item img {
      display: block;

      width: 100%;
      height: auto;

      object-fit: contain;
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 760px) {

      .case-hero-media,
      .case-gallery {
        width: 100%;
        max-width: none;
      }


      .case-gallery {
        grid-template-columns:
          1fr;

        gap: 18px;

        margin-bottom: 32px;
      }


      .case-gallery--tall-pair
      .case-gallery__item,
      .case-gallery--wide-pair
      .case-gallery__item {
        height: auto;

        overflow: visible;
      }


      .case-gallery--tall-pair
      .case-gallery__item img,
      .case-gallery--wide-pair
      .case-gallery__item img {
        width: 100%;
        height: auto;
      }

    }

  </style>

</Base>