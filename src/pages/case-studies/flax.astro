---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "FLAX Hospitality POS | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            FLAX<br />
            Hospitality POS
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A clearer international product story for a configurable
            hospitality POS platform, connecting product UX, brand
            direction, frontend and social content.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Product design</span>
            <span>UX/UI</span>
            <span>Brand direction</span>
            <span>Frontend</span>
            <span>Social content</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2026
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media">
        <img
          src="/images/flax/hero.webp"
          alt="FLAX Hospitality website hero"
        />
      </figure>


      <!-- ===================================================
           FIRST GRID
      ==================================================== -->

      <section
        class="case-gallery"
        aria-label="FLAX project screens"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/flax/workspace.webp"
            alt="FLAX product workspace"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/flax/verticals.webp"
            alt="FLAX hospitality verticals"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          The direction puts
          <span class="case-statement__accent">
            hospitality first
          </span>
          — real service environments, product UI and a clearer
          story around configurable restaurant workflows.
        </p>

      </section>


      <!-- ===================================================
           PRODUCT UI — FULL WIDTH
      ==================================================== -->

      <section
        class="case-gallery case-gallery--wide"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/flax/product-ui.webp"
            alt="FLAX POS product interface"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           SECOND GRID
      ==================================================== -->

      <section class="case-gallery">

        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/flax/features.webp"
            alt="FLAX product feature architecture"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/flax/brand.webp"
            alt="FLAX brand story"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           ECOSYSTEM
      ==================================================== -->

      <section
        class="case-gallery case-gallery--wide"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/flax/ecosystem.webp"
            alt="FLAX product ecosystem"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           INSTAGRAM
      ==================================================== -->

      <section class="case-gallery">

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/flax/instagram.webp"
            alt="FLAX global Instagram direction"
            loading="lazy"
          />
        </figure>


        <div class="case-link-panel">
          <p class="case-meta__label">
            live
          </p>

          <h3>
            See the work in context.
          </h3>

          <div class="case-link-panel__links">
            <a
              href="https://resto.flax.com/en"
              target="_blank"
              rel="noreferrer"
            >
              Website ↗
            </a>

            <a
              href="https://www.instagram.com/flaxpos.global/"
              target="_blank"
              rel="noreferrer"
            >
              Instagram ↗
            </a>
          </div>
        </div>

      </section>


     <!-- ===================================================
     NEXT PROJECT
==================================================== -->

<a
  class="case-next"
  href="/case-studies/nav-system"
>
  <div>
    <span class="case-next__eyebrow">
      next project
    </span>

    <h2 class="case-next__title">
      Unified<br />
      Navigation<br />
      System
    </h2>
  </div>

  <span
    class="case-next__arrow"
    aria-hidden="true"
  >
    ↗
  </span>
</a>

    </div>
  </article>
</Base>


<style>
  /* FLAX-specific small live-links panel */

  .case-link-panel {
    min-height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding:
      clamp(28px, 4vw, 60px);

    box-sizing: border-box;

    background: #191a17;

    border:
      1px solid
      rgba(242, 241, 236, .09);
  }


  .case-link-panel h3 {
    max-width: 420px;

    margin:
      40px 0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      clamp(2rem, 3vw, 3.6rem);

    font-weight: 650;

    line-height: .98;

    letter-spacing: -.05em;

    color: #f2f1ec;
  }


  .case-link-panel__links {
    display: flex;
    flex-direction: column;

    align-items: flex-start;

    gap: 8px;
  }


  .case-link-panel__links a {
    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      1.1rem;

    font-weight: 500;

    color:
      #d8f27a;

    text-decoration: none;

    transition:
      opacity .18s ease;
  }


  .case-link-panel__links a:hover {
    opacity: .68;
  }


  @media (max-width: 760px) {
    .case-link-panel {
      min-height: 330px;
    }
  }
</style>