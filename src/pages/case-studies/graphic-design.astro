---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Brand & Visual Identity | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Brand &<br />
            Visual<br />
            Identity
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            Visual work across packaging, campaigns,
            identity, illustration and 3D composition —
            combining fine-art thinking with typography,
            structure and commercial communication.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Art direction</span>
            <span>Graphic design</span>
            <span>Illustration</span>
            <span>Packaging</span>
            <span>3D visualisation</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            years
          </p>

          <p class="case-meta__value">
            2013–2025
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="design-hero">
        <img
          src="/images/design/beauty.webp"
          alt="Beauty Bites packaging and 3D visual composition"
        />
      </figure>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          Visual instinct built on
          <span class="case-statement__accent">
            composition, rhythm and emotion.
          </span>
        </p>

      </section>


      <!-- ===================================================
           01 / PACKAGING
      ==================================================== -->

      <section class="design-section">

        <div class="design-section__head">

          <span class="design-eyebrow">
            01 / packaging
          </span>

          <h2>
            Product as<br />
            visual object.
          </h2>

          <p>
            Packaging and campaign compositions developed through
            typography, colour, spatial hierarchy and 3D rendering.
          </p>

        </div>


        <div class="design-grid design-grid--2">

          <figure class="design-card">
            <img
              src="/images/design/typesetter1.webp"
              alt="Eternal Youth campaign moodshot"
              loading="lazy"
            />

            <figcaption>
              <strong>Eternal Youth</strong>
              <span>CAMPAIGN · TYPOGRAPHY · 3D VISUAL</span>
            </figcaption>
          </figure>

          <figure class="design-card">
            <img
              src="/images/design/kell.webp"
              alt="Beauty Bites product close-up"
              loading="lazy"
            />

            <figcaption>
              <strong>Product close-up</strong>
              <span>COMPOSITION · PACKAGING · 3D</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           02 / CAMPAIGN
      ==================================================== -->

      <section class="design-section">

        <div class="design-section__head">

          <span class="design-eyebrow">
            02 / campaigns
          </span>

          <h2>
            Type, colour<br />
            and attitude.
          </h2>

          <p>
            Campaign visuals use typography and image treatment
            to create a recognisable mood before communicating
            individual product details.
          </p>

        </div>


        <div class="design-grid design-grid--2">

          
             <figure class="design-card">
            <img
              src="/images/design/shoko.webp"
              alt="Beauty Bites packaging render"
              loading="lazy"
            />

            <figcaption>
              <strong>Beauty Bites</strong>
              <span>PACKAGING · 3D RENDER · ART DIRECTION</span>
            </figcaption>
          </figure>


          <figure class="design-card">
            <img
              src="/images/design/king-toss.webp"
              alt="Eternal Youth advertising visual"
              loading="lazy"
            />

            <figcaption>
              <strong>Ad visual</strong>
              <span>ART DIRECTION · TYPE HIERARCHY</span>
            </figcaption>
          </figure>


          <figure class="design-card design-card--wide">
            <img
              src="/images/design/torn.webp"
              alt="Product lineup 3D composition"
              loading="lazy"
            />

            <figcaption>
              <strong>Product lineup</strong>
              <span>3D COMPOSITION · PACKAGING SYSTEM</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           LARGE STATEMENT
      ==================================================== -->

      <section class="design-statement">

        <span class="design-eyebrow">
          background
        </span>

        <p>
          Fine arts taught me to
          see structure before decoration.
        </p>

      </section>


      <!-- ===================================================
           03 / OBJECTS
      ==================================================== -->

      <section class="design-section">

        <div class="design-section__head">

          <span class="design-eyebrow">
            03 / visual studies
          </span>

          <h2>
            Form, material<br />
            and atmosphere.
          </h2>

          <p>
            3D and illustration became tools for building imagery
            that could sit somewhere between product photography,
            graphic design and visual experimentation.
          </p>

        </div>


        <figure class="design-card design-card--wide">
          <img
            src="/images/design/purgid-up.webp"
            alt="Jaanihanso cider bottles 3D render"
            loading="lazy"
          />

          <figcaption>
            <strong>Jaanihanso</strong>
            <span>3D RENDER · PRODUCT VISUALISATION · COMPOSITION</span>
          </figcaption>
        </figure>


        <div class="design-grid design-grid--2 design-grid--after-wide">

          <figure class="design-card">
            <img
              src="/images/design/purgid.webp"
              alt="Jaanihanso cider moodshot"
              loading="lazy"
            />

            <figcaption>
              <strong>Cider moodshot</strong>
              <span>FORM · MATERIAL · LIGHTING</span>
            </figcaption>
          </figure>


          <figure class="design-card">
            <img
              src="/images/design/typesetter2.webp"
              alt="Victor badminton Christmas card"
              loading="lazy"
            />

            <figcaption>
              <strong>Victor</strong>
              <span>EDITORIAL · TYPOGRAPHY · SPORT</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           04 / IDENTITY
      ==================================================== -->

      <section class="design-section">

        <div class="design-section__head">

          <span class="design-eyebrow">
            04 / identity
          </span>

          <h2>
            Reduced to<br />
            a mark.
          </h2>

          <p>
            Identity studies range from symbolic marks to quieter,
            minimal systems where proportion and typography carry
            most of the character.
          </p>

        </div>


        <div class="design-grid design-grid--2">

          <figure class="design-card">
            <img
              src="/images/design/imepuu.webp"
              alt="Symbolic logo concept"
              loading="lazy"
            />

            <figcaption>
              <strong>Symbolic mark</strong>
              <span>LOGO · FORM · VISUAL NARRATIVE</span>
            </figcaption>
          </figure>


          <figure class="design-card">
            <img
              src="/images/design/Lagom2.webp"
              alt="Lagom logo identity"
              loading="lazy"
            />

            <figcaption>
              <strong>Lagom</strong>
              <span>IDENTITY · TYPOGRAPHY · MINIMALISM</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           05 / ILLUSTRATION
      ==================================================== -->

      <section class="design-section">

        <div class="design-section__head">

          <span class="design-eyebrow">
            05 / illustration
          </span>

          <h2>
            Place, memory<br />
            and image.
          </h2>

          <p>
            Illustration allows a looser visual language where
            architecture, history and atmosphere can become part
            of the composition.
          </p>

        </div>


        <figure class="design-card design-card--wide">
          <img
            src="/images/design/viru-hotell.webp"
            alt="Viru Hotel 50th anniversary illustration"
            loading="lazy"
          />

          <figcaption>
            <strong>Viru Hotel 50</strong>
            <span>ILLUSTRATION · ARCHITECTURE · CULTURAL HERITAGE</span>
          </figcaption>
        </figure>

      </section>


      <!-- ===================================================
           FINAL STATEMENT
      ==================================================== -->

      <section class="design-final">

        <span class="design-eyebrow">
          approach
        </span>

        <p>
          Visual direction that still
          has to communicate.
        </p>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/visual-explorations"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            Illustration &<br />
            Visual Studies
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>


  <style is:global>

    html,
    body {
      background: #0d0f0d !important;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .design-hero {
      margin: 0;
    }


    .design-hero img {
      display: block;

      width: 100%;
      height: auto;

      background: #151815;
    }



    /* =====================================================
       SECTION
    ====================================================== */

    .design-section {
      margin-top:
        clamp(120px, 12vw, 190px);
    }


    .design-section__head {
      display: grid;

      grid-template-columns:
        .65fr
        1.25fr
        1fr;

      gap:
        clamp(32px, 5vw, 82px);

      padding-top: 28px;

      margin-bottom:
        clamp(54px, 6vw, 90px);

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .design-eyebrow {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;
      font-weight: 500;

      line-height: 1;

      letter-spacing: .07em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }


    .design-section__head h2 {
      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(2.7rem, 4.5vw, 5.4rem);

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;

      color: #f2f1ec;
    }


    .design-section__head p {
      max-width: 470px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1rem, 1.2vw, 1.25rem);

      line-height: 1.42;

      color:
        rgba(242,241,236,.63);
    }



    /* =====================================================
       GRID
    ====================================================== */

    .design-grid {
      display: grid;
    }


    .design-grid--2 {
      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        clamp(42px,4vw,68px)
        clamp(22px,2.6vw,40px);
    }


    .design-grid--after-wide {
      margin-top: 40px;
    }



    /* =====================================================
       IMAGE
       no forced aspect ratio = less unnecessary blur/crop
    ====================================================== */

    .design-card {
      margin: 0;

      min-width: 0;
    }


    .design-card img {
      display: block;

      width: 100%;
      height: auto;

      background: #151815;
    }


    .design-card--wide {
      grid-column: 1 / -1;
    }



    /* =====================================================
       CAPTIONS
    ====================================================== */

    .design-card figcaption {
      display: flex;

      align-items: baseline;

      gap: 16px;

      padding-top: 14px;
    }


    .design-card figcaption strong {
      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1.3rem, 1.7vw, 1.8rem);

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.04em;

      color: #f2f1ec;
    }


    /*
      You asked for these to be readable:
      keep uppercase text at 1rem
    */

    .design-card figcaption span {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;

      font-weight: 500;

      line-height: 1.15;

      letter-spacing: .045em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }



    /* =====================================================
       LARGE STATEMENT
    ====================================================== */

    .design-statement,
    .design-final {
      display: grid;

      grid-template-columns:
        .65fr
        2.25fr;

      gap: 40px;

      margin-top:
        clamp(145px,14vw,220px);

      margin-bottom:
        clamp(140px,13vw,200px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .design-statement p,
    .design-final p {
      max-width: 1150px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(3.4rem,6.8vw,7.8rem);

      font-weight: 650;

      line-height: .87;

      letter-spacing: -.07em;

      color: #f2f1ec;
    }



    /* =====================================================
       NEXT PROJECT ARROW
       same ring as Social Media / FLAX / Telia
    ====================================================== */

    .case-next__arrow {
      display: flex;

      align-items: center;
      justify-content: center;

      width: 68px;
      height: 68px;

      flex: 0 0 68px;

      border:
        2px solid #d8f27a;

      border-radius: 50%;

      color: #d8f27a;

      font-family:
        Arial,
        sans-serif;

      font-size: 2.2rem;

      font-weight: 400;

      line-height: 1;

      transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }


    .case-next:hover
    .case-next__arrow {
      background: #d8f27a;

      color: #0d0f0d;

      transform:
        translate(4px,-4px);
    }



    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1000px) {

      .design-section__head {
        grid-template-columns:
          1fr 1.5fr;
      }


      .design-section__head p {
        grid-column: 2;
      }

    }



    /* =====================================================
       MOBILE
    ====================================================== */

    @media (max-width: 760px) {

      .design-section {
        margin-top: 100px;
      }


      .design-section__head {
        grid-template-columns: 1fr;

        gap: 20px;
      }


      .design-section__head p {
        grid-column: auto;
      }


      .design-grid--2 {
        grid-template-columns: 1fr;
      }


      .design-card--wide {
        grid-column: auto;
      }


      .design-card figcaption {
        flex-direction: column;

        align-items: flex-start;

        gap: 7px;
      }


      .design-card figcaption span {
        font-size: 1rem;
      }


      .design-statement,
      .design-final {
        grid-template-columns: 1fr;

        gap: 24px;

        margin-top: 110px;
        margin-bottom: 110px;
      }


      .design-statement p,
      .design-final p {
        font-size:
          clamp(3rem,14vw,5.2rem);
      }


      .case-next__arrow {
        width: 54px;
        height: 54px;

        flex-basis: 54px;

        font-size: 1.8rem;
      }

    }

  </style>

</Base>