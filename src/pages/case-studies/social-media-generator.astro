---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "AI Social Media Generator | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- META -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            AI Social Media<br />
            Generator
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A guided Instagram content workflow that connects
            onboarding, brand setup, AI-assisted content generation,
            planning and publishing in one product.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Product design</span>
            <span>UX/UI</span>
            <span>Frontend</span>
            <span>AI workflows</span>
            <span>API integrations</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2026
          </p>
        </div>

      </section>

<!-- HERO -->

<section class="case-social-hero">
  <img
    src="/images/social-media-generator/instagram-grid.webp"
    alt="Instagram content generated and published through the Social Media Generator"
  />
</section>


      <!-- FIRST GRID -->

      <section
        class="case-gallery"
        aria-label="AI Social Media Generator screens"
      >

        <figure class="case-gallery__item case-gallery__item--landscape case-gallery__item--zoom">
          <img
            src="/images/social-media-generator/connected.webp"
            alt="Connected Instagram account"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/social-media-generator/brand-font.webp"
            alt="Brand typography setup"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- STATEMENT -->

      <section class="case-statement">

        <p class="case-statement__text">
          Designed as one continuous flow from
          <span class="case-statement__accent">
            brand setup
          </span>
          to generated content, planning and real publishing.
        </p>

      </section>


      <!-- SECOND GRID -->

<!-- SECOND GRID -->

<section class="case-gallery">

  <figure class="case-gallery__item case-gallery__item--landscape">
    <img
      src="/images/social-media-generator/planner-size.webp"
      alt="Content cadence selection"
      loading="lazy"
    />
  </figure>

  <figure class="case-gallery__item case-gallery__item--landscape">
    <img
      src="/images/social-media-generator/brand-brief.webp"
      alt="Brand brief and content setup"
      loading="lazy"
    />
  </figure>

</section>


      <!-- FINAL IMAGE -->

      <section
        class="case-gallery case-gallery--wide"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/social-media-generator/instagram-post.webp"
            alt="Published Instagram post"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- NEXT PROJECT -->

      <a
        class="case-next"
        href="/case-studies/flax"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            FLAX<br />
            Hospitality POS
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>
  <style>
  .case-social-hero {
    width: 100%;
    max-width: 1176px;

    margin: 0 auto 48px;

    overflow: hidden;
  }

  .case-social-hero img {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;

    /* ära lase browseril seda üle originaalsuuruse venitada */
    image-rendering: auto;
  }

  /*
    Sama laius alumistele galeriidele,
    et kõik vasak/right servad jookseksid kokku.
  */
  .case-gallery {
    width: 100%;
    max-width: 1176px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 760px) {
    .case-social-hero,
    .case-gallery {
      max-width: none;
      width: 100%;
    }

    .case-social-hero {
      margin-bottom: 28px;
    }
  }
.case-social-hero,
.case-gallery {
  width: 100%;
  max-width: 1176px;
  margin-left: auto;
  margin-right: auto;
}

.case-social-hero {
  margin-bottom: 52px;
}

.case-social-hero img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}

/* 2-column rows exactly span same width as hero */
.case-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  /* important: smaller gap = larger images */
  gap: 24px;

  margin-bottom: 54px;
}

.case-gallery__item {
  width: 100%;
  margin: 0;
}

.case-gallery__item img {
  display: block;
  width: 100%;
  height: auto;
}

/* single full-width image at bottom */
.case-gallery--wide {
  display: block;
}

.case-gallery--wide .case-gallery__item {
  width: 100%;
}

.case-gallery--wide img {
  width: 100%;
  height: auto;
}

@media (max-width: 760px) {
  .case-social-hero,
  .case-gallery {
    width: 100%;
    max-width: none;
  }

  .case-gallery {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .case-social-hero {
    margin-bottom: 30px;
  }
}

.case-gallery__item--zoom {
  position: relative;
  overflow: hidden;
  background: #fff;
}

.case-gallery__item--zoom img {
  width: 112%;
  max-width: none;
  height: auto;

  margin-left: -6%;

  transform: scale(1.08);
  transform-origin: center center;
}
</style>
</Base>