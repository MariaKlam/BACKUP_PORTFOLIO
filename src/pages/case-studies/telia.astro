---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Telia Help & Guides UX Analysis | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Telia Help<br />
            & Guides<br />
            UX Analysis
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A usability study of Telia’s mobile Help & Guides
            experience — identifying navigation friction,
            testing alternative flows and designing a simpler
            step-by-step support experience.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>UX research</span>
            <span>Usability testing</span>
            <span>Information architecture</span>
            <span>UX/UI</span>
            <span>Prototyping</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2024
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media telia-hero">
        <img
          src="/images/telia/telia-hero.webp"
          alt="Telia Help and Guides prototype overview"
        />
      </figure>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          The problem wasn’t missing information.
          It was knowing
          <span class="case-statement__accent">
            where to start.
          </span>
        </p>

      </section>


      <!-- ===================================================
           01 — PROBLEM
      ==================================================== -->

      <section class="telia-section">

        <div class="telia-section__head">

          <span class="telia-eyebrow">
            01 / problem
          </span>

          <h2>
            Too many paths.<br />
            Too little clarity.
          </h2>

          <p>
            Support content existed across multiple entry points
            with inconsistent labels and hierarchy. Users had to
            decide where information might be before they could
            actually solve the problem.
          </p>

        </div>


        <div class="telia-grid telia-grid--2">

          <figure class="telia-card">

            <img
              src="/images/telia/telia1.webp"
              alt="Original Telia navigation problem"
              loading="lazy"
            />

            <figcaption>
              <strong>Navigation</strong>
              <span>HIDDEN OPTIONS · UNCLEAR ENTRY POINTS</span>
            </figcaption>

          </figure>


          <figure class="telia-card">

            <img
              src="/images/telia/before_gif.webp"
              alt="Original factory reset experience"
              loading="lazy"
            />

            <figcaption>
              <strong>Factory reset</strong>
              <span>WEAK HIERARCHY · MOBILE FRICTION</span>
            </figcaption>

          </figure>

        </div>

      </section>


      <!-- ===================================================
           02 — RESEARCH
      ==================================================== -->

      <section class="telia-section">

        <div class="telia-section__head">

          <span class="telia-eyebrow">
            02 / research
          </span>

          <h2>
            Test behavior,<br />
            not assumptions.
          </h2>

          <p>
            Scenario-based usability testing and interviews were
            used to observe how people searched for help without
            guiding them toward the expected answer.
          </p>

        </div>


        <div class="telia-grid telia-grid--2">

          <figure class="telia-card">

            <img
              src="/images/telia/personad.webp"
              alt="Telia usability study personas"
              loading="lazy"
            />

            <figcaption>
              <strong>Personas</strong>
              <span>NEEDS · EXPECTATIONS · CONTEXT</span>
            </figcaption>

          </figure>


          <figure class="telia-card">

            <img
              src="/images/telia/kasutajauuring.webp"
              alt="Telia user testing process"
              loading="lazy"
            />

            <figcaption>
              <strong>User testing</strong>
              <span>OBSERVATION · TASKS · THINK ALOUD</span>
            </figcaption>

          </figure>

        </div>

      </section>


      <!-- ===================================================
           RESEARCH STATEMENT
      ==================================================== -->

      <section class="telia-big-statement">

        <span class="telia-eyebrow">
          insight
        </span>

        <p>
          The simplest solution
          consistently created the
          highest confidence.
        </p>

      </section>


      <!-- ===================================================
           03 — EXPLORATION
      ==================================================== -->

      <section class="telia-section">

        <div class="telia-section__head">

          <span class="telia-eyebrow">
            03 / exploration
          </span>

          <h2>
            Explore first.<br />
            Simplify second.
          </h2>

          <p>
            Different navigation patterns were prototyped and
            tested before reducing the solution to a clearer
            structure with visible choices and fewer hidden states.
          </p>

        </div>


        <figure class="telia-card telia-card--wide">

          <img
            src="/images/telia/slider.gif"
            alt="Telia navigation prototype alternatives"
            loading="lazy"
          />

          <figcaption>
            <strong>Navigation exploration</strong>
            <span>SKETCHES · PROTOTYPES · TESTING · ITERATION</span>
          </figcaption>

        </figure>

      </section>


      <!-- ===================================================
           04 — SOLUTION
      ==================================================== -->

      <section class="telia-section">

        <div class="telia-section__head">

          <span class="telia-eyebrow">
            04 / solution
          </span>

          <h2>
            One step<br />
            at a time.
          </h2>

          <p>
            The final direction used progressive disclosure and
            stronger hierarchy to turn a dense support article into
            a guided mobile task.
          </p>

        </div>


        <figure class="telia-card telia-card--wide">

          <img
            src="/images/telia/after_gif.webp"
            alt="Improved factory reset help flow"
            loading="lazy"
          />

          <figcaption>
            <strong>Guided help flow</strong>
            <span>CLEAR STEPS · MOBILE FIRST · PROGRESSIVE DISCLOSURE</span>
          </figcaption>

        </figure>

      </section>


      <!-- ===================================================
           05 — OUTCOME
      ==================================================== -->

      <section class="telia-section telia-outcome-section">

        <div class="telia-section__head">

          <span class="telia-eyebrow">
            05 / outcome
          </span>

          <h2>
            Research into<br />
            production.
          </h2>

          <p>
            A version of the simplified navigation pattern later
            appeared in Telia’s live product, closely reflecting
            the direction presented during the project.
          </p>

        </div>


        <figure class="telia-card telia-card--wide">

          <img
            src="/images/telia/vordlus.webp"
            alt="Comparison between prototype and Telia production navigation"
            loading="lazy"
          />

          <figcaption>
            <strong>Prototype → product</strong>
            <span>VISIBLE OPTIONS · FEWER TAPS · CLEARER NAVIGATION</span>
          </figcaption>

        </figure>

      </section>


      <!-- ===================================================
           FINAL STATEMENT
      ==================================================== -->

      <section class="telia-final">

        <span class="telia-eyebrow">
          outcome
        </span>

        <p>
          Less searching.<br />
          More solving.
        </p>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/graphic-design"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            Brand &<br />
            Visual Identity
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>


  <style is:global>

    /* =====================================================
       TELIA
    ====================================================== */

    html,
    body {
      background: #0d0f0d !important;
    }


    .telia-section,
    .telia-big-statement,
    .telia-final {
      width: 100%;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .telia-hero img {
      display: block;

      width: 100%;
      aspect-ratio: 16 / 8.4;

      object-fit: cover;

      background: #151815;
    }


    /* =====================================================
       SECTION HEADER
    ====================================================== */

    .telia-section {
      margin-top:
        clamp(120px, 12vw, 190px);
    }


    .telia-section__head {
      display: grid;

      grid-template-columns:
        .65fr
        1.25fr
        1fr;

      gap:
        clamp(32px, 5vw, 82px);

      padding-top: 28px;

      margin-bottom:
        clamp(54px, 6vw, 90px);

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .telia-eyebrow {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;
      font-weight: 500;

      line-height: 1;

      letter-spacing: .07em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }


    .telia-section__head h2 {
      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(2.7rem, 4.5vw, 5.4rem);

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;

      color: #f2f1ec;
    }


    .telia-section__head p {
      max-width: 470px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1rem, 1.2vw, 1.25rem);

      line-height: 1.42;

      color:
        rgba(242,241,236,.63);
    }


    /* =====================================================
       GRID
    ====================================================== */

    .telia-grid {
      display: grid;
    }


    .telia-grid--2 {
      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        clamp(42px, 4vw, 68px)
        clamp(22px, 2.6vw, 40px);
    }


    /* =====================================================
       IMAGE CARDS
    ====================================================== */

    .telia-card {
      margin: 0;
    }


    .telia-card img {
      display: block;

      width: 100%;
      aspect-ratio: 16 / 9;

      object-fit: cover;

      background: #151815;
    }


    .telia-card--wide img {
      aspect-ratio: 16 / 8.2;
    }


    .telia-card figcaption {
      display: flex;
      align-items: baseline;

      gap: 16px;

      padding-top: 14px;
    }


    .telia-card figcaption strong {
      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1.3rem, 1.7vw, 1.8rem);

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.04em;

      color: #f2f1ec;
    }


    /*
      IMPORTANT:
      small uppercase text under images
      deliberately 1rem for readability
    */

    .telia-card figcaption span {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;

      font-weight: 500;

      line-height: 1.15;

      letter-spacing: .045em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }


    /* =====================================================
       BIG INSIGHT
    ====================================================== */

    .telia-big-statement {
      display: grid;

      grid-template-columns:
        .65fr
        2.25fr;

      gap: 40px;

      margin-top:
        clamp(140px, 14vw, 210px);

      margin-bottom:
        clamp(140px, 14vw, 210px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .telia-big-statement p {
      max-width: 1120px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(3.4rem, 6.8vw, 7.8rem);

      font-weight: 650;

      line-height: .87;

      letter-spacing: -.07em;

      color: #f2f1ec;
    }


    /* =====================================================
       FINAL
    ====================================================== */

    .telia-final {
      display: grid;

      grid-template-columns:
        .65fr
        2.25fr;

      gap: 40px;

      margin-top:
        clamp(145px, 14vw, 220px);

      margin-bottom:
        clamp(130px, 12vw, 190px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .telia-final p {
      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(3.5rem, 7vw, 8rem);

      font-weight: 650;

      line-height: .86;

      letter-spacing: -.07em;

      color: #f2f1ec;
    }


    /* =====================================================
       NEXT PROJECT ARROW
       same as Social Media / FLAX
    ====================================================== */

    .case-next__arrow {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 68px;
      height: 68px;

      flex: 0 0 68px;

      border: 2px solid #d8f27a;

      border-radius: 50%;

      color: #d8f27a;

      font-family: Arial, sans-serif;

      font-size: 2.2rem;
      font-weight: 400;
      line-height: 1;

      transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }


    .case-next:hover .case-next__arrow {
      background: #d8f27a;

      color: #0d0f0d;

      transform:
        translate(4px,-4px);
    }


    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1000px) {

      .telia-section__head {
        grid-template-columns:
          1fr 1.5fr;
      }


      .telia-section__head p {
        grid-column: 2;
      }

    }


    /* =====================================================
       MOBILE
    ====================================================== */

    @media (max-width: 760px) {

      .telia-section {
        margin-top: 100px;
      }


      .telia-section__head {
        grid-template-columns: 1fr;

        gap: 20px;
      }


      .telia-section__head p {
        grid-column: auto;
      }


      .telia-grid--2 {
        grid-template-columns: 1fr;
      }


      .telia-card figcaption {
        flex-direction: column;

        align-items: flex-start;

        gap: 7px;
      }


      /*
        keep readable on mobile too
      */

      .telia-card figcaption span {
        font-size: 1rem;
      }


      .telia-big-statement,
      .telia-final {
        grid-template-columns: 1fr;

        gap: 24px;
      }


      .telia-big-statement p,
      .telia-final p {
        font-size:
          clamp(3rem, 14vw, 5.2rem);
      }


      .case-next__arrow {
        width: 54px;
        height: 54px;

        flex-basis: 54px;

        font-size: 1.8rem;
      }

    }

  </style>

</Base>