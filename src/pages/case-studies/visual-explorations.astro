---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Illustration & Visual Studies | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">project</p>

          <h1 class="case-meta__value">
            Illustration &<br />
            Visual Studies
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">bio</p>

          <p class="case-meta__bio">
            An ongoing exploration of composition, rhythm,
            movement and atmosphere across illustration,
            posters and creative coding.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">deliverables</p>

          <div class="case-meta__stack">
            <span>Illustration</span>
            <span>Poster design</span>
            <span>Creative coding</span>
            <span>Visual composition</span>
            <span>Art direction</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">years</p>

          <p class="case-meta__value">
            2012–2025
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="visual-hero">
        <img
          src="/images/visual/kompa.webp"
          alt="Abstract visual composition"
        />
      </figure>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          Structure and instinct
          can exist in the
          <span class="case-statement__accent">
            same image.
          </span>
        </p>

      </section>


      <!-- ===================================================
           01 / DIGITAL
      ==================================================== -->

      <section class="visual-section">

        <div class="visual-section__head">

          <span class="visual-eyebrow">
            01 / digital
          </span>

          <h2>
            Motion,<br />
            rhythm, systems.
          </h2>

          <p>
            Digital experiments let me work with repetition,
            timing and composition in ways that sit somewhere
            between interface logic and visual art.
          </p>

        </div>


        <div class="visual-grid visual-grid--2">

          <figure class="visual-card">
            <img
              src="/images/visual/gif1.gif"
              alt="Creative JavaScript composition"
              loading="lazy"
            />

            <figcaption>
              <strong>Creative JavaScript composition</strong>
              <span>CREATIVE CODE · MOTION · RHYTHM</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/supernoova.webp"
              alt="Supernoova fashion show poster"
              loading="lazy"
            />

            <figcaption>
              <strong>Supernoova</strong>
              <span>ILLUSTRATION · POSTER · ART DIRECTION</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           02 / INK
      ==================================================== -->

      <section class="visual-section">

        <div class="visual-section__head">

          <span class="visual-eyebrow">
            02 / ink
          </span>

          <h2>
            Movement through<br />
            contrast and space.
          </h2>

          <p>
            Traditional ink work became a way to study
            focal points, visual weight and negative space
            before translating the same thinking into digital work.
          </p>

        </div>


        <div class="visual-grid visual-grid--2">

          <figure class="visual-card">
            <img
              src="/images/visual/divein.webp"
              alt="Dive In ink illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Dive In</strong>
              <span>INK · COMPOSITION · MOVEMENT</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/metskits.webp"
              alt="Autumn Is Coming ink illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Autumn Is Coming</strong>
              <span>INK · BALANCE · TEXT SPACE</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/trapped.webp"
              alt="Trapped ink illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Trapped</strong>
              <span>INK · PERSPECTIVE · CONFINEMENT</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/spring.webp"
              alt="Spring ink illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Spring</strong>
              <span>INK · ORGANIC FORM · LIGHTNESS</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           PATTERN
      ==================================================== -->

      <section class="visual-wide-block">

        <span class="visual-eyebrow">
          repetition study
        </span>

        <figure class="visual-card visual-card--wide">
          <img
            src="/images/visual/trapped_pattern.webp"
            alt="Pattern composition based on Trapped illustration"
            loading="lazy"
          />

          <figcaption>
            <strong>Pattern Composition</strong>
            <span>REPETITION · SCALE · RHYTHM · STRUCTURE</span>
          </figcaption>
        </figure>

      </section>


      <!-- ===================================================
           BIG STATEMENT
      ==================================================== -->

      <section class="visual-statement">

        <span class="visual-eyebrow">
          composition
        </span>

        <p>
          I usually think about
          the text before the image
          is even finished.
        </p>

      </section>


      <!-- ===================================================
           03 / POSTERS
      ==================================================== -->

      <section class="visual-section">

        <div class="visual-section__head">

          <span class="visual-eyebrow">
            03 / posters
          </span>

          <h2>
            Image and type<br />
            designed together.
          </h2>

          <p>
            In poster work, illustration is never separate
            from typography. The composition is built around
            where information will eventually live.
          </p>

        </div>


        <div class="visual-grid visual-grid--2">

          <figure class="visual-card">
            <img
              src="/images/visual/tartu.webp"
              alt="Event poster composition"
              loading="lazy"
            />

            <figcaption>
              <strong>Tartu</strong>
              <span>POSTER · ILLUSTRATION · TYPE HIERARCHY</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/unblock.webp"
              alt="Unblock poster illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Unblock</strong>
              <span>HAND DRAWN · TYPOGRAPHY · RHYTHM</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/tekhnasia.webp"
              alt="Tekhnasia poster"
              loading="lazy"
            />

            <figcaption>
              <strong>Tekhnasia</strong>
              <span>EVENT POSTER · TYPE · COMPOSITION</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/dnbb.webp"
              alt="Music poster illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Music & Form</strong>
              <span>POSTER · MOVEMENT · MUSIC</span>
            </figcaption>
          </figure>


          <figure class="visual-card visual-card--wide">
            <img
              src="/images/visual/TTT1.webp"
              alt="Event poster with integrated typography"
              loading="lazy"
            />

            <figcaption>
              <strong>Event composition</strong>
              <span>ILLUSTRATION · TYPOGRAPHY · ART DIRECTION</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           04 / MUSIC
      ==================================================== -->

      <section class="visual-section">

        <div class="visual-section__head">

          <span class="visual-eyebrow">
            04 / music
          </span>

          <h2>
            Sound translated<br />
            into image.
          </h2>

          <p>
            Music-related work explores pace, repetition
            and dynamic balance through visual composition.
          </p>

        </div>


        <figure class="visual-card visual-card--wide">
          <img
            src="/images/visual/armada.webp"
            alt="Armada CD cover"
            loading="lazy"
          />

          <figcaption>
            <strong>Armada</strong>
            <span>CD COVER · MUSIC · DYNAMIC COMPOSITION · 2012</span>
          </figcaption>
        </figure>

      </section>


      <!-- ===================================================
           05 / PLACE
      ==================================================== -->

      <section class="visual-section">

        <div class="visual-section__head">

          <span class="visual-eyebrow">
            05 / place
          </span>

          <h2>
            Illustration as<br />
            visual memory.
          </h2>

          <p>
            Architecture, maps and local identity become
            narrative material rather than simply documentation.
          </p>

        </div>


        <div class="visual-grid visual-grid--2">

          <figure class="visual-card">
            <img
              src="/images/visual/hoone.webp"
              alt="Ministry of Defence building illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Sakala 1/3</strong>
              <span>ARCHITECTURE · ILLUSTRATION · TALLINN</span>
            </figcaption>
          </figure>


          <figure class="visual-card">
            <img
              src="/images/visual/vinni.webp"
              alt="Vinni municipality illustrated sightseeing map"
              loading="lazy"
            />

            <figcaption>
              <strong>Vinni Municipality</strong>
              <span>ILLUSTRATED MAP · PLACE · STORYTELLING</span>
            </figcaption>
          </figure>


          <figure class="visual-card visual-card--wide">
            <img
              src="/images/visual/koos.webp"
              alt="Koos.io watercolor illustration"
              loading="lazy"
            />

            <figcaption>
              <strong>Koos.io</strong>
              <span>WATERCOLOR · CORPORATE GIFT · ILLUSTRATION</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           FINAL
      ==================================================== -->

      <section class="visual-final">

        <span class="visual-eyebrow">
          approach
        </span>

        <p>
          Visual thinking before
          visual decoration.
        </p>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

<a
  class="case-next"
  href="/case-studies/email-marketing"
>

  <div>
    <span class="case-next__eyebrow">
      next project
    </span>

    <h2 class="case-next__title">
      Email Marketing<br />
      Platform
    </h2>
  </div>


  <span
    class="case-next__arrow"
    aria-hidden="true"
  >
    ↗
  </span>

</a>

    </div>
  </article>


  <style is:global>

    html,
    body {
      background: #0d0f0d !important;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .visual-hero {
      margin: 0;
    }


    .visual-hero img {
      display: block;
      width: 100%;
      height: auto;

      background: #151815;
    }


    /* =====================================================
       SECTION
    ====================================================== */

    .visual-section {
      margin-top:
        clamp(120px, 12vw, 190px);
    }


    .visual-section__head {
      display: grid;

      grid-template-columns:
        .65fr 1.25fr 1fr;

      gap:
        clamp(32px, 5vw, 82px);

      padding-top: 28px;

      margin-bottom:
        clamp(54px, 6vw, 90px);

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .visual-eyebrow {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;
      font-weight: 500;

      line-height: 1;

      letter-spacing: .07em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }


    .visual-section__head h2 {
      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(2.7rem, 4.5vw, 5.4rem);

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;

      color: #f2f1ec;
    }


    .visual-section__head p {
      max-width: 470px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1rem, 1.2vw, 1.25rem);

      line-height: 1.42;

      color:
        rgba(242,241,236,.63);
    }


    /* =====================================================
       GRID
    ====================================================== */

    .visual-grid {
      display: grid;
    }


    .visual-grid--2 {
      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        clamp(44px, 4vw, 72px)
        clamp(22px, 2.6vw, 40px);
    }


    /* =====================================================
       IMAGE
       IMPORTANT: no forced aspect ratio
    ====================================================== */

    .visual-card {
      margin: 0;
      min-width: 0;
    }


    .visual-card img {
      display: block;

      width: 100%;
      height: auto;

      max-width: 100%;

      background: #151815;
    }


    .visual-card--wide {
      grid-column: 1 / -1;
      width: 100%;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }


    /* =====================================================
       CAPTIONS
    ====================================================== */

    .visual-card figcaption {
      display: flex;

      align-items: baseline;

      gap: 16px;

      padding-top: 14px;
    }


    .visual-card figcaption strong {
      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1.3rem, 1.7vw, 1.8rem);

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.04em;

      color: #f2f1ec;
    }


    .visual-card figcaption span {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;

      font-weight: 500;

      line-height: 1.15;

      letter-spacing: .045em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.48);
    }


    /* =====================================================
       WIDE BLOCK
    ====================================================== */

    .visual-wide-block {
      margin-top:
        clamp(130px, 13vw, 200px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .visual-wide-block
    .visual-card {
      margin-top: 34px;
    }


    /* =====================================================
       STATEMENTS
    ====================================================== */

    .visual-statement,
    .visual-final {
      display: grid;

      grid-template-columns:
        .65fr 2.25fr;

      gap: 40px;

      margin-top:
        clamp(145px,14vw,220px);

      margin-bottom:
        clamp(140px,13vw,200px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .visual-statement p,
    .visual-final p {
      max-width: 1150px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(3.4rem,6.8vw,7.8rem);

      font-weight: 650;

      line-height: .87;

      letter-spacing: -.07em;

      color: #f2f1ec;
    }


    /* =====================================================
       NEXT PROJECT ARROW
    ====================================================== */

    .case-next__arrow {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 68px;
      height: 68px;

      flex: 0 0 68px;

      border: 2px solid #d8f27a;
      border-radius: 50%;

      color: #d8f27a;

      font-family: Arial, sans-serif;
      font-size: 2.2rem;
      font-weight: 400;
      line-height: 1;

      transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }


    .case-next:hover
    .case-next__arrow {
      background: #d8f27a;

      color: #0d0f0d;

      transform:
        translate(4px,-4px);
    }


    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1000px) {

      .visual-section__head {
        grid-template-columns:
          1fr 1.5fr;
      }


      .visual-section__head p {
        grid-column: 2;
      }

    }


    /* =====================================================
       MOBILE
    ====================================================== */

    @media (max-width: 760px) {

      .visual-section {
        margin-top: 100px;
      }


      .visual-section__head {
        grid-template-columns: 1fr;

        gap: 20px;
      }


      .visual-section__head p {
        grid-column: auto;
      }


      .visual-grid--2 {
        grid-template-columns: 1fr;
      }


      .visual-card--wide {
        grid-column: auto;
      }
      


      .visual-card figcaption {
        flex-direction: column;
        align-items: flex-start;

        gap: 7px;
      }


      .visual-card figcaption span {
        font-size: 1rem;
      }


      .visual-statement,
      .visual-final {
        grid-template-columns: 1fr;

        gap: 24px;

        margin-top: 110px;
        margin-bottom: 110px;
      }


      .visual-statement p,
      .visual-final p {
        font-size:
          clamp(3rem,14vw,5.2rem);
      }


      .case-next__arrow {
        width: 54px;
        height: 54px;

        flex-basis: 54px;

        font-size: 1.8rem;
      }

    }

  </style>

</Base>