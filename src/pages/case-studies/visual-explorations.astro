---
import Base from "../../layouts/Base.astro";
import "../../styles/case-base.css";

const title = "Case Study: Visual explorations";
---
<Base title={title} noWrap={false} hideFooter={false}>
  

  <article class="container-narrow doc-grid tokens-case">
              <!-- LEFT rail (Prev) -->
    <nav class="case-rail case-rail--left" aria-label="Previous project">
      <a class="pager-btn pager-btn--prev" href="/case-studies/graphic-design" aria-label="Previous: Brand & Visual Identity">
        <svg class="pager-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      </a>
    </nav>
    <div class="doc-main">

      <section class="hero-vertical" aria-label="Featured previews">
        <button class="shot-tile ar-21x9"
          data-full="/images/visual/kompa.webp"
          data-title="Visual Composition"
          data-cap="
          <ul>
            <li>Abstract form and rhythm to create visual flow.</li>
            <li>Study of repetition and focal hierarchy.</li>
            <li>Merging design system logic with artistic texture.</li>
          </ul>">
          <img decoding="async" src="/images/visual/kompa.webp" alt="Visual composition exploration">
        </button>
      </section>

      <header class="case-hero mt-header">
    <h1>Visual explorations</h1>
    <p class="meta">Graphic Design • Illustration • Art Direction • 2013–2025</p>
    <p class="lede">
      These illustrations are part of an ongoing exploration of composition, rhythm, and atmosphere - principles that also guide my work in UX and UI. I combine traditional techniques with digital tools to create expressive, balanced visuals that merge artistic intuition with design structure.
    </p>
  </header>

      <section id="s-context">
        <h2>Context & Purpose</h2>
        <p>
          Illustration has always been part of how I think and design. My education in fine arts gave me a foundation in composition, light, and storytelling - 
          skills that translate directly into product design and interface clarity. These explorations help me maintain an emotional and narrative sensibility 
          within structured, system-driven work.
        </p>
      </section>

      <section id="s-approach">
        <h2>Approach</h2>
        <ul>
          <li>Composition - if I do illustration for a project I think where to put text right away.</li>
          <li>Experimenting with mixed media - from ink and graphite to 3D renders and vector layers.</li>
          <li>Focusing on composition, movement, and focal points to communicate emotion.</li>
          <li>Adapting illustration methods to digital product contexts: icons, hero imagery, and editorial visuals.</li>
          <li>Integrating storytelling and atmosphere into structured layouts and UI patterns.</li>
        </ul>
      </section>

      <section id="s-outcomes">
        <h2>Outcomes</h2>
        <ul>
          <li>Developed a personal visual language that connects artistic intuition with interface design principles.</li>
          <li>Improved understanding of rhythm, spacing, and balance - directly influencing my UI layout work.</li>
          <li>Created cohesive visual systems for campaigns and digital experiences through illustration.</li>
        </ul>
      </section>

      <section id="s-role">
        <h2>My Background</h2>
        <ul>
          <li>Bachelor of Arts in Fine Arts - Estonian Academy of Arts.</li>
          <li>Professional experience across art direction, illustration, and interface design.</li>
          <li>Bridging artistic craft with structured design systems in UX/UI environments.</li>
          <li>Continuous exploration of how emotional tone and aesthetics can support usability and clarity.</li>
        </ul>
      </section>

       <p class="flex-col links-container">
        <a class="btn link-btn" href="/case-studies/nav-system">
          <span class="btn-label">Check a demo of unified navigation menu</span>
          <i class="ri-arrow-right-line"></i>
        </a>
        <a class="btn link-btn" href="/case-studies/dash-case">
            <span class="btn-label">Dashboards and app interfaces</span>
          <i class="ri-arrow-right-line"></i>
        </a>
      </p>
    </div>

    <aside class="doc-aside feature-card">
      <nav class="shots-grid" aria-label="Visual gallery">
        <button class="shot-tile"
          data-full="/images/visual/supernoova.webp"
          data-title="Poster for Supernoova Fashion Show"
          data-cap="<p>Digital illustration. Supernoova as an outer-space goddess representing the show’s galactic theme.</p>">
          <img decoding="async" src="/images/visual/supernoova.webp" alt="Poster: Supernoova fashion show — outer-space goddess illustration" loading="lazy">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/gif1.gif"
          data-title="Creative JavaScript Composition"
          data-cap="<p>Creative coding experiment in pure JavaScript — exploring composition, rhythm, and minimal, expressive motion.</p>">
          <img decoding="async" src="/images/visual/gif1.gif" alt="Abstract grid animation created with JavaScript" loading="lazy">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/divein.webp"
          data-title="Dive In"
          data-cap="<p>Digitized traditional ink illustration.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/divein.webp" alt="Ink illustration titled ‘Dive In’">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/metskits.webp"
          data-title="Autumn Is Coming"
          data-cap="<p>Digitized traditional ink illustration, composed to work with a text block on the left.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/metskits.webp" alt="Autumn is coming — ink illustration">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/trapped.webp"
          data-title="Trapped"
          data-cap="<p>Digitized traditional ink illustration. A composition study exploring confinement and perspective.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/trapped.webp" alt="Trapped — composition study in ink">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/trapped_pattern.webp"
          data-title="Pattern Composition"
          data-cap="<p>Repetition study based on <em>Trapped</em> — exploring rhythm, balance, and structure at scale.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/trapped_pattern.webp" alt="Pattern derived from Trapped illustration">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/tartu.webp"
          data-title="Poster Composition"
          data-cap="<p>Event poster illustration. Composition and visual hierarchy designed with text placement from the start.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/tartu.webp" alt="Event poster — composition with integrated typography">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/unblock.webp"
          data-title="Poster Composition"
          data-cap="<p>Poster illustration. Balancing hand-drawn forms with typographic structure to create rhythm and hierarchy.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/unblock.webp" alt="Poster illustration — image and type hierarchy">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/tekhnasia.webp"
          data-title="Poster Composition"
          data-cap="<p>Poster illustration. Composition and type integration studied together for balanced storytelling.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/tekhnasia.webp" alt="Event poster — composition and typography integration">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/dnbb.webp"
          data-title="Music & Form"
          data-cap="<p>Poster illustration exploring movement, rhythm, and composition with integrated typography.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/dnbb.webp" alt="Music-inspired poster — dynamic composition with type">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/TTT1.webp"
          data-title="Music & Form"
          data-cap="<p>Event poster illustration. Dynamic composition and how illustrated forms interact with type layout.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/TTT1.webp" alt="Event poster — dynamic composition interacting with typography">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/spring.webp"
          data-title="Spring"
          data-cap="<p>Digitized ink illustration.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/spring.webp" alt="Spring — ink illustration">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/armada.webp"
          data-title="CD Cover (2012)"
          data-cap="<p>Dynamic composition inspired by movement and sound. CD cover for Armada (Raun Juurikas, Peedu Kass, Andre Maaker).</p>">
          <img decoding="async" loading="lazy" src="/images/visual/armada.webp" alt="CD cover — dynamic composition">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/hoone.webp"
          data-title="Ministry of Defence"
          data-cap="<p>Illustration of the Ministry of Defence building at Sakala 1/3, Tallinn.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/hoone.webp" alt="Ministry of Defence building — illustration">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/vinni.webp"
          data-title="Vinni Municipality"
          data-cap="<p>Illustrated sightseeing map for Vinni municipality.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/vinni.webp" alt="Illustrated sightseeing map — Vinni municipality">
        </button>

        <button class="shot-tile"
          data-full="/images/visual/koos.webp"
          data-title="Koos.io"
          data-cap="<p>Traditional watercolor illustration created as a corporate gift.</p>">
          <img decoding="async" loading="lazy" src="/images/visual/koos.webp" alt="Watercolor illustration titled ‘Koos’">
        </button>
      </nav>
    </aside>

<!-- Lightweight lightbox (scoped to .tokens-case) -->
<div class="tokens-lightbox" aria-hidden="true">
  <div class="tokens-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Image preview">
    <button class="tokens-lightbox__close" type="button" aria-label="Close (Esc)">×</button>
    <button class="tokens-lightbox__nav tokens-lightbox__prev" aria-label="Previous image">‹</button>
    <button class="tokens-lightbox__nav tokens-lightbox__next" aria-label="Next image">›</button>

    <div class="tokens-lightbox__media">
      <img class="tokens-lightbox__img" alt="" />
    </div>
    <aside class="tokens-lightbox__meta">
      <h4 class="tokens-lightbox__title"></h4>
      <div class="tokens-lightbox__cap"></div>
    </aside>
  </div>
</div>
<!-- RIGHT rail (Next) -->
    <nav class="case-rail case-rail--right" aria-label="Next project">
      <a class="pager-btn pager-btn--next" href="/case-studies/nav-system" aria-label="Next: Unified Navigation System">
        <svg class="pager-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </nav>
  </article>
  
<script type="module">
(() => {
  const scope = document.querySelector('.tokens-case');
  if (!scope) return;

  const lb       = scope.querySelector('.tokens-lightbox');
  const dlg      = lb.querySelector('.tokens-lightbox__dialog');
  const imgEl    = lb.querySelector('.tokens-lightbox__img');
  const titleEl  = lb.querySelector('.tokens-lightbox__title');
  const capEl    = lb.querySelector('.tokens-lightbox__cap');
  const closeBtn = lb.querySelector('.tokens-lightbox__close');
  const prevBtn  = lb.querySelector('.tokens-lightbox__prev');
  const nextBtn  = lb.querySelector('.tokens-lightbox__next');

  const tiles = Array.from(scope.querySelectorAll('.shot-tile'));
  let currentIndex = -1;
  let lastFocus = null;

  function extractDataFrom(el) {
    const carrier = el.closest('[data-full],[data-cap],[data-title]') || el;
    const img     = (el.tagName === 'IMG') ? el : carrier.querySelector('img');
    const src   = carrier.getAttribute('data-full') || img?.currentSrc || img?.src || '';
    const title = carrier.getAttribute('data-title') || img?.alt || '';
    const cap   = carrier.getAttribute('data-cap') || img?.title || '';
    return { src, title, cap };
  }

  function openLightbox(index) {
    currentIndex = index;
    const { src, title, cap } = extractDataFrom(tiles[index]);
    lastFocus = document.activeElement;
    imgEl.src = src;
    titleEl.textContent = title;
    capEl.innerHTML = cap;
    lb.classList.add('is-open');
    document.documentElement.classList.add('tokens-lightbox-open');
    closeBtn.focus();
  }

  function closeLightbox() {
    lb.classList.remove('is-open');
    document.documentElement.classList.remove('tokens-lightbox-open');
    imgEl.src = ''; titleEl.textContent = ''; capEl.textContent = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  function showNext() {
    if (currentIndex === -1) return;
    currentIndex = (currentIndex + 1) % tiles.length;
    openLightbox(currentIndex);
  }

  function showPrev() {
    if (currentIndex === -1) return;
    currentIndex = (currentIndex - 1 + tiles.length) % tiles.length;
    openLightbox(currentIndex);
  }

  scope.addEventListener('click', e => {
    const tile = e.target.closest('.shot-tile');
    if (tile) {
      e.preventDefault();
      openLightbox(tiles.indexOf(tile));
    }
  });

  closeBtn.addEventListener('click', closeLightbox);
  prevBtn.addEventListener('click', showPrev);
  nextBtn.addEventListener('click', showNext);
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });

  document.addEventListener('keydown', e => {
    if (!lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'ArrowLeft') showPrev();
  });
})();
</script>

</Base>
<style>
  .hero-vertical {
    margin-top: 40px;
  }

  .feature-card {
  position: sticky;
  top: clamp(50px, 8vh, 90px) !important;
  height: fit-content;
  box-shadow: none;
  padding: 40px 0;
}

.ar-21x9 {
  aspect-ratio: 21 / 9; /* consistent height across all hero images */
  display: block;
}

.ar-21x9 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 767.98px) {
  .hero-vertical {
    margin-top: 20px;
  }

}
</style>