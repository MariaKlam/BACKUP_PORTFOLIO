---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Isekas Self-Service Checkout | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Isekas<br />
            Self-Service
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A product-led landing experience for a self-service checkout
            solution, built around clearer use cases, stronger product
            packaging and a more distinctive visual direction.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Product design</span>
            <span>UX/UI</span>
            <span>Visual direction</span>
            <span>Frontend</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2026
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media">
        <img
          src="/images/isekas/hero.webp"
          alt="Isekas self-service checkout landing page"
        />
      </figure>


      <!-- ===================================================
           FIRST GRID
      ==================================================== -->

      <section
        class="case-gallery"
        aria-label="Isekas project screens"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/use-cases.webp"
            alt="Isekas use cases"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/kit.webp"
            alt="Isekas complete product solution"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          The product became easier to understand by moving from
          abstract features to
          <span class="case-statement__accent">
            real business scenarios.
          </span>
        </p>

      </section>


      <!-- ===================================================
           LIFESTYLE — FULL WIDTH
      ==================================================== -->

      <section
        class="case-gallery case-gallery--wide"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/isekas/lifestyle.webp"
            alt="Isekas lifestyle and usage environments"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           PRICING + ORIGINAL CONCEPT
      ==================================================== -->

      <section class="case-gallery">

        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/pricing.webp"
            alt="Isekas pricing and configuration options"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/concept.webp"
            alt="Earlier Isekas landing page concept"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           LIVE LINK
      ==================================================== -->

      <section class="case-live-strip">

        <div>
          <p class="case-meta__label">
            live
          </p>

          <h3>
            See the product in context.
          </h3>
        </div>


        <a
          href="https://isekas.kassa.net/"
          target="_blank"
          rel="noreferrer"
          class="case-live-strip__link"
        >
          Visit site ↗
        </a>

      </section>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/ui-library-tokens"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            UI Library &<br />
            Token System
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>
</Base>


<style>
  .case-live-strip {
    display: grid;
    grid-template-columns: 1fr auto;

    align-items: end;

    gap: 30px;

    margin-top:
      clamp(80px, 9vw, 130px);

    padding:
      clamp(28px, 4vw, 54px);

    background: #191a17;

    border:
      1px solid
      rgba(242, 241, 236, .09);
  }


  .case-live-strip h3 {
    max-width: 560px;

    margin: 0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      clamp(2rem, 3vw, 3.8rem);

    font-weight: 650;

    line-height: .98;

    letter-spacing: -.05em;

    color: #f2f1ec;
  }


  .case-live-strip__link {
    color: #d8f27a;

    text-decoration: none;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size: 1.1rem;
    font-weight: 600;

    white-space: nowrap;

    transition:
      opacity .18s ease,
      transform .18s ease;
  }


  .case-live-strip__link:hover {
    opacity: .68;

    transform:
      translate(3px, -3px);
  }


  @media (max-width: 760px) {
    .case-live-strip {
      grid-template-columns: 1fr;

      align-items: start;
    }


    .case-live-strip__link {
      margin-top: 18px;
    }
  }
</style>