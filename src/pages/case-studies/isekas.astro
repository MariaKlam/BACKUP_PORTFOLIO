---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Isekas Self-Service Checkout | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Isekas<br />
            Self-Service
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A product-led landing experience for a self-service checkout
            solution, built around clearer use cases, stronger product
            packaging and a more distinctive visual direction.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>Product design</span>
            <span>UX/UI</span>
            <span>Visual direction</span>
            <span>Frontend</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2026
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media case-hero-media--video">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/images/isekas/hero.webp"
          aria-label="Isekas self-service checkout experience"
        >
          <source
            src="/videos/iseka-screen.mp4"
            type="video/mp4"
          />
        </video>
      </figure>


      <!-- ===================================================
           FIRST GRID
      ==================================================== -->

      <section
        class="case-gallery"
        aria-label="Isekas project screens"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/use-cases.webp"
            alt="Isekas use cases"
            loading="lazy"
          />
        </figure>


        <figure
          class="case-gallery__item
                 case-gallery__item--landscape"
        >
          <img
            src="/images/isekas/kit.webp"
            alt="Isekas complete product solution"
            loading="lazy"
          />
        </figure>

      </section>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          The product became easier to understand by moving from
          abstract features to
          <span class="case-statement__accent">
            real business scenarios.
          </span>
        </p>

      </section>


      <!-- ===================================================
           LIFESTYLE — FULL WIDTH
      ==================================================== -->

      <section
        class="case-gallery case-gallery--wide"
      >

        <figure
          class="case-gallery__item
                 case-gallery__item--natural"
        >
          <img
            src="/images/isekas/lifestyle.webp"
            alt="Isekas lifestyle and usage environments"
            loading="lazy"
          />
        </figure>

      </section>


    <!-- ===================================================
     PRICING + LIVE CTA
==================================================== -->

<section class="case-duo-row">

  <figure
    class="case-gallery__item
           case-gallery__item--landscape"
  >
    <img
      src="/images/isekas/pricing.webp"
      alt="Isekas pricing and configuration options"
      loading="lazy"
    />
  </figure>

  <section class="case-live-strip">
    <div>
      <p class="case-meta__label">
        live
      </p>

      <h3>
        See the product in context.
      </h3>
    </div>

    <a
      href="https://isekas.kassa.net/"
      target="_blank"
      rel="noreferrer"
      class="case-live-strip__link"
    >
      Visit site ↗
    </a>
  </section>

</section>





      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/ui-library-tokens"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            UI Library &<br />
            Token System
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>
</Base>


<style>
  .case-live-strip {
    display: grid;
    grid-template-columns: 1fr auto;

    align-items: end;

    gap: 30px;

    margin-top:
      clamp(80px, 9vw, 130px);

    padding:
      clamp(28px, 4vw, 54px);

    background: #191a17;

    border:
      1px solid
      rgba(242, 241, 236, .09);
  }


  .case-live-strip h3 {
    max-width: 560px;

    margin: 0;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size:
      clamp(2rem, 3vw, 3.8rem);

    font-weight: 650;

    line-height: .98;

    letter-spacing: -.05em;

    color: #f2f1ec;
  }


  .case-live-strip__link {
    color: #d8f27a;

    text-decoration: none;

    font-family:
      "Inter Tight",
      var(--ui-font),
      sans-serif;

    font-size: 1.1rem;
    font-weight: 600;

    white-space: nowrap;

    transition:
      opacity .18s ease,
      transform .18s ease;
  }


  .case-live-strip__link:hover {
    opacity: .68;

    transform:
      translate(3px, -3px);
  }


  @media (max-width: 760px) {
    .case-live-strip {
      grid-template-columns: 1fr;

      align-items: start;
    }


    .case-live-strip__link {
      margin-top: 18px;
    }
  }

  /* =====================================================
   ISEKAS MEDIA ALIGNMENT
===================================================== */

.case-hero-media,
.case-gallery {
  width: 100%;
  max-width: 1176px;

  margin-left: auto;
  margin-right: auto;
}

/* hero */
.case-hero-media {
  margin-bottom: 48px;
}

.case-hero-media img {
  display: block;

  width: 100%;
  height: auto;
}


/* 2-column image rows */
.case-gallery {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 24px;

  margin-top: 24px;
  margin-bottom: 48px;
}

.case-gallery__item {
  width: 100%;
  margin: 0;
}

.case-gallery__item img {
  display: block;
  width: 100%;
}


/* two matching landscape cards */
.case-gallery__item--landscape {
  aspect-ratio: 16 / 10;
}

.case-gallery__item--landscape img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* full-width lifestyle image */
.case-gallery--wide {
  display: block;
}

.case-gallery--wide .case-gallery__item {
  width: 100%;
}

.case-gallery--wide .case-gallery__item img {
  width: 100%;
  height: auto;

  object-fit: contain;
}


/* live strip same outer width too */
.case-live-strip {
  width: 100%;
  max-width: 1176px;

  margin-left: auto;
  margin-right: auto;

  box-sizing: border-box;
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 760px) {

  .case-hero-media,
  .case-gallery,
  .case-live-strip {
    width: 100%;
    max-width: none;
  }

  .case-gallery {
    grid-template-columns: 1fr;

    gap: 18px;

    margin-bottom: 32px;
  }

  .case-gallery__item--landscape {
    aspect-ratio: auto;
  }

  .case-gallery__item--landscape img {
    height: auto;
  }
}

.case-duo-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;

  width: 100%;
  max-width: 1176px;

  margin: 24px auto 48px;

  align-items: stretch;
}

.case-duo-row .case-gallery__item,
.case-duo-row .case-live-strip {
  height: 100%;
  margin: 0;
}

.case-duo-row .case-gallery__item {
  overflow: hidden;
}

.case-duo-row .case-gallery__item img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: top center;
}

.case-live-strip {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;

  gap: 30px;

  padding: clamp(28px, 4vw, 54px);

  box-sizing: border-box;

  background: #191a17;
  border: 1px solid rgba(242, 241, 236, .09);
}

@media (max-width: 760px) {
  .case-duo-row {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .case-duo-row .case-gallery__item,
  .case-duo-row .case-live-strip {
    height: auto;
  }

  .case-duo-row .case-gallery__item img {
    height: auto;
    object-fit: contain;
  }
}

.case-hero-media--video {
  overflow: hidden;
  background: #111210;
}

.case-hero-media--video video {
  display: block;
  width: 100%;
  height: auto;
}

/* =========================================================
   NAV SYSTEM — MATCH ISEKAS / EDITORIAL META
========================================================= */

body.nav-system-page .nav-editorial__intro {
  width: 100%;
  max-width: var(--main-max);
  margin-inline: auto;

  padding:
    148px
    var(--gutter)
    0;

  box-sizing: border-box;
}

body.nav-system-page .nav-editorial__meta {
  display: grid;

  grid-template-columns:
    1.05fr
    1.65fr
    1.3fr
    0.55fr;

  gap: clamp(28px, 4vw, 74px);

  align-items: start;

  margin: 0 0 clamp(60px, 7vw, 105px);
}


/* labels */
body.nav-system-page .nav-editorial__label {
  margin: 0 0 18px;

  font-family:
    "Oswald",
    "Arial Narrow",
    sans-serif;

  font-size: 1rem;
  font-weight: 500;

  line-height: 1;

  letter-spacing: 0.08em;
  text-transform: lowercase;

  color:
    rgba(242, 241, 236, 0.48);
}


/* PROJECT TITLE — same as Isekas */
body.nav-system-page .nav-editorial__title {
  margin: 0;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size:
    clamp(1.35rem, 1.75vw, 2rem) !important;

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -0.035em;

  color: #f2f1ec;
}


/* BIO — same as Isekas */
body.nav-system-page .nav-editorial__bio {
  max-width: 430px;

  margin: 0;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size:
    clamp(0.98rem, 1.05vw, 1.1rem) !important;

  font-weight: 400;

  line-height: 1.34;

  letter-spacing: -0.012em;

  color:
    rgba(242, 241, 236, 0.72);
}


/* DELIVERABLES — same as Isekas */
body.nav-system-page .nav-editorial__stack {
  display: flex;
  flex-direction: column;

  gap: 2px;

  margin: 0;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size:
    clamp(1.25rem, 1.65vw, 1.85rem) !important;

  font-weight: 500;

  line-height: 1.04;

  letter-spacing: -0.035em;

  color: #f2f1ec;
}


/* YEAR — same as project title */
body.nav-system-page .nav-editorial__year {
  margin: 0;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size:
    clamp(1.35rem, 1.75vw, 2rem) !important;

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -0.035em;

  color: #f2f1ec;
}


/* PROJECTS LINK — same as editorial */
body.nav-system-page .nav-editorial__back {
  display: inline-flex;

  align-items: center;
  gap: 10px;

  margin-top: 38px;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size: 0.95rem;
  font-weight: 500;

  color: #f2f1ec;

  text-decoration: none;
}

body.nav-system-page .nav-editorial__back svg {
  width: 28px;
  height: 28px;
}


/* =========================================================
   DEMO START
   remove giant empty gap
========================================================= */

body.nav-system-page .nav-editorial__demo-head {
  width: 100%;
  max-width: var(--main-max);

  margin:
    0 auto 0;

  padding-top:
    26px;

  border-top:
    1px solid rgba(242, 241, 236, 0.12);
}

body.nav-system-page .nav-editorial__demo-head h2 {
  margin:
    10px 0 0;

  font-family:
    "Inter Tight",
    var(--ui-font),
    sans-serif;

  font-size:
    clamp(2rem, 3.2vw, 4rem) !important;

  font-weight: 600;

  line-height: 0.98;

  letter-spacing: -0.055em;
}


/* =========================================================
   MOBILE — SAME META AS ISEKAS
========================================================= */

@media (max-width: 760px) {

  /* hide entire demo navigation */
  #menuMasterToggle,
  .master-menu_mobile-header,
  .mobile-menu-overlay,
  .thin-sidebar-group,
  .menu,
  .company-sidebar,
  .extra-thin-sidebar {
    display: none !important;
  }

  body.nav-system-page .site-header {
    margin-left: 0 !important;
    width: 100% !important;
  }

  body.nav-system-page .nav-editorial {
    margin-left: 0 !important;
    width: 100% !important;
  }


  body.nav-system-page .nav-editorial__intro {
    width: 100%;
    max-width: none;

    margin: 0;

    padding:
      108px
      18px
      0;

    box-sizing: border-box;
  }


  body.nav-system-page .nav-editorial__meta {
    display: grid !important;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr) !important;

    gap:
      34px
      18px !important;

    align-items: start;

    margin:
      0 0 54px !important;
  }


  body.nav-system-page .nav-editorial__block {
    min-width: 0;
  }


  body.nav-system-page .nav-editorial__label {
    margin-bottom:
      10px;

    font-size:
      0.66rem !important;
  }


  body.nav-system-page .nav-editorial__title,
  body.nav-system-page .nav-editorial__year {
    font-size:
      1.32rem !important;

    line-height:
      1.04 !important;
  }


  body.nav-system-page .nav-editorial__bio {
    max-width: none;

    font-size:
      0.92rem !important;

    line-height:
      1.34 !important;
  }


  body.nav-system-page .nav-editorial__stack {
    font-size:
      1.2rem !important;

    line-height:
      1.04 !important;
  }


  body.nav-system-page .nav-editorial__back {
    margin-top:
      22px;
  }


  body.nav-system-page .nav-editorial__demo-head {
    margin:
      0 18px;

    width:
      calc(100% - 36px);

    padding-top:
      24px;
  }


  body.nav-system-page .nav-editorial__demo-head h2 {
    font-size:
      clamp(2.2rem, 11vw, 3.5rem) !important;
  }
}
</style>