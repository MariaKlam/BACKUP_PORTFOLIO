---
import Base from "../../layouts/Base.astro";
import "../../styles/case-editorial.css";

const title = "Dashboard & Application Patterns | Maria Klammer";
---

<Base
  title={title}
  bodyClass="case-editorial-shell"
  noWrap={true}
  hideFooter={true}
>
  <article class="case-editorial">
    <div class="case-editorial__inner">

      <!-- ===================================================
           META
      ==================================================== -->

      <section class="case-meta">

        <div class="case-meta__block">
          <p class="case-meta__label">
            project
          </p>

          <h1 class="case-meta__value">
            Dashboard &<br />
            Application<br />
            Patterns
          </h1>

          <a
            class="case-back"
            href="/projects"
            aria-label="Back to projects"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 5L5 19" />
              <path d="M5 19V8" />
              <path d="M5 19h11" />
            </svg>

            Projects
          </a>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            bio
          </p>

          <p class="case-meta__bio">
            A scalable application framework for data-heavy
            operational products — shared layouts, dashboard
            patterns, tables, states and chart components used
            across a large product ecosystem.
          </p>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            deliverables
          </p>

          <div class="case-meta__stack">
            <span>UX/UI</span>
            <span>Frontend</span>
            <span>Application patterns</span>
            <span>Charts library</span>
            <span>Accessibility</span>
          </div>
        </div>


        <div class="case-meta__block">
          <p class="case-meta__label">
            year
          </p>

          <p class="case-meta__value">
            2023–2025
          </p>
        </div>

      </section>


      <!-- ===================================================
           HERO
      ==================================================== -->

      <figure class="case-hero-media dashboard-hero">
        <img
          src="/images/tokens/bo-dashboard.webp"
          alt="Operational dashboard overview"
        />
      </figure>


      <!-- ===================================================
           STATEMENT
      ==================================================== -->

      <section class="case-statement">

        <p class="case-statement__text">
          One application language
          across
          <span class="case-statement__accent">
            200+ product views.
          </span>
        </p>

      </section>


      <!-- ===================================================
           DASHBOARD SYSTEM
      ==================================================== -->

      <section class="dashboard-section">

        <div class="dashboard-section__head">

          <span class="dashboard-eyebrow">
            01 / application system
          </span>

          <h2>
            Same foundations.<br />
            Different workflows.
          </h2>

          <p>
            Shared page structure, navigation, filters, actions and
            states allow individual applications to stay consistent
            without becoming visually identical.
          </p>

        </div>


        <div class="dashboard-grid dashboard-grid--2">

          <figure class="dashboard-card">
            <img
              src="/images/tokens/bo-main.webp"
              alt="Main dashboard variations"
              loading="lazy"
            />

            <figcaption>
              <strong>Main dashboards</strong>
              <span>configurable product entry points</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/post-login-d.webp"
              alt="Post login dashboard"
              loading="lazy"
            />

            <figcaption>
              <strong>Post-login views</strong>
              <span>context-aware starting points</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           PRODUCT APPLICATIONS
      ==================================================== -->

      <section class="dashboard-section">

        <div class="dashboard-section__head">

          <span class="dashboard-eyebrow">
            02 / product patterns
          </span>

          <h2>
            Built for real<br />
            operational work.
          </h2>

          <p>
            Dense application UI needs predictable hierarchy,
            reusable interaction rules and enough flexibility for
            different business contexts.
          </p>

        </div>


        <div class="dashboard-grid dashboard-grid--2">

          <figure class="dashboard-card">
            <img
              src="/images/tokens/crmapp.webp"
              alt="CRM application interface"
              loading="lazy"
            />

            <figcaption>
              <strong>CRM applications</strong>
              <span>shared layout · forms · tables</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/sales.webp"
              alt="Sales application interface"
              loading="lazy"
            />

            <figcaption>
              <strong>Sales applications</strong>
              <span>filtering · bulk actions · responsive data</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/wizard-dashboard.webp"
              alt="Wizard dashboard"
              loading="lazy"
            />

            <figcaption>
              <strong>Wizard flows</strong>
              <span>progressive disclosure · guided actions</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/login.webp"
              alt="Login interface"
              loading="lazy"
            />

            <figcaption>
              <strong>System entry</strong>
              <span>authentication · errors · recovery states</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           CHART SYSTEM
      ==================================================== -->

      <section class="dashboard-section">

        <div class="dashboard-section__head">

          <span class="dashboard-eyebrow">
            03 / data visualisation
          </span>

          <h2>
            Charts belong to<br />
            the system too.
          </h2>

          <p>
            The chart library extends the same token architecture
            into data visualisation with reusable, responsive and
            theme-aware chart foundations.
          </p>

        </div>


        <figure class="dashboard-card dashboard-card--wide">
          <img
            src="/images/tokens/charts-library.webp"
            alt="Charts library overview"
            loading="lazy"
          />

          <figcaption>
            <strong>Charts Library</strong>
            <span>token driven · responsive · theme aware</span>
          </figcaption>
        </figure>


        <div class="dashboard-grid dashboard-grid--3 charts-grid">

          <figure class="dashboard-card">
            <img
              src="/images/tokens/pieline.webp"
              alt="Line and pie chart examples"
              loading="lazy"
            />

            <figcaption>
              <strong>Line & pie</strong>
              <span>core chart patterns</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/round.webp"
              alt="Donut chart component"
              loading="lazy"
            />

            <figcaption>
              <strong>Donut</strong>
              <span>theme-aware data display</span>
            </figcaption>
          </figure>


          <figure class="dashboard-card">
            <img
              src="/images/tokens/radar-chart.webp"
              alt="Radar chart examples"
              loading="lazy"
            />

            <figcaption>
              <strong>Radar & funnel</strong>
              <span>extended analytical patterns</span>
            </figcaption>
          </figure>

        </div>

      </section>


      <!-- ===================================================
           FINAL STATEMENT
      ==================================================== -->

      <section class="dashboard-final">

        <span class="dashboard-eyebrow">
          outcome
        </span>

        <p>
          Less reinvention.<br />
          More predictable products.
        </p>

      </section>


      <!-- ===================================================
           FINAL VISUAL
      ==================================================== -->

      <figure class="dashboard-final-image">
        <img
          src="/images/tokens/bar.webp"
          alt="Bar chart system"
          loading="lazy"
        />
      </figure>


      <!-- ===================================================
           NEXT PROJECT
      ==================================================== -->

      <a
        class="case-next"
        href="/case-studies/telia"
      >

        <div>
          <span class="case-next__eyebrow">
            next project
          </span>

          <h2 class="case-next__title">
            Telia Help &<br />
            Guides UX Analysis
          </h2>
        </div>


        <span
          class="case-next__arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>

    </div>
  </article>


  <style is:global>

    /* =====================================================
       PAGE
    ====================================================== */

    html,
    body {
      background: #0d0f0d !important;
    }


    .dashboard-section,
    .dashboard-final,
    .dashboard-final-image {
      width: 100%;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .dashboard-hero img {
      display: block;

      width: 100%;
      aspect-ratio: 16 / 8.2;

      object-fit: cover;

      background: #151815;
    }


    /* =====================================================
       SECTIONS
    ====================================================== */

    .dashboard-section {
      margin-top: clamp(120px, 12vw, 190px);
    }


    .dashboard-section__head {
      display: grid;

      grid-template-columns:
        .65fr
        1.25fr
        1fr;

      gap: clamp(32px, 5vw, 82px);

      padding-top: 28px;
      margin-bottom: clamp(54px, 6vw, 90px);

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .dashboard-eyebrow {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: .75rem;

      letter-spacing: .09em;

      text-transform: lowercase;

      color:
        rgba(242,241,236,.45);
    }


    .dashboard-section__head h2 {
      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(2.7rem, 4.5vw, 5.4rem);

      font-weight: 650;

      line-height: .9;

      letter-spacing: -.06em;

      color: #f2f1ec;
    }


    .dashboard-section__head p {
      max-width: 460px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1rem, 1.15vw, 1.2rem);

      line-height: 1.42;

      color:
        rgba(242,241,236,.62);
    }


    /* =====================================================
       GRID
    ====================================================== */

    .dashboard-grid {
      display: grid;
    }


    .dashboard-grid--2 {
      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        clamp(42px, 4vw, 68px)
        clamp(22px, 2.6vw, 40px);
    }


    .dashboard-grid--3 {
      grid-template-columns:
        repeat(3, minmax(0,1fr));

      gap: 24px;
    }


    .dashboard-card {
      margin: 0;
    }


    .dashboard-card img {
      display: block;

      width: 100%;

      aspect-ratio: 16 / 9;

      object-fit: cover;

      background: #151815;
    }


    .dashboard-card--wide {
      margin-bottom: 34px;
    }


    .dashboard-card--wide img {
      aspect-ratio: 16 / 7.8;
    }


    .dashboard-card figcaption {
      display: flex;
      align-items: baseline;

      gap: 12px;

      padding-top: 12px;
    }


    .dashboard-card figcaption strong {
      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(1.15rem, 1.5vw, 1.65rem);

      font-weight: 600;

      line-height: 1;

      letter-spacing: -.035em;

      color: #f2f1ec;
    }


    .dashboard-card figcaption span {
      font-family:
        "Oswald",
        "Arial Narrow",
        sans-serif;

      font-size: 1rem;

      letter-spacing: .06em;

      text-transform: uppercase;

      color:
        rgba(242,241,236,.42);
    }


    /* =====================================================
       CHARTS
    ====================================================== */

    .charts-grid {
      margin-top: 26px;
    }


    /* =====================================================
       FINAL STATEMENT
    ====================================================== */

    .dashboard-final {
      display: grid;

      grid-template-columns:
        .65fr 2.25fr;

      gap: 40px;

      margin-top:
        clamp(140px, 14vw, 210px);

      padding-top: 28px;

      border-top:
        1px solid
        rgba(242,241,236,.13);
    }


    .dashboard-final p {
      max-width: 1100px;

      margin: 0;

      font-family:
        "Inter Tight",
        sans-serif;

      font-size:
        clamp(3.4rem, 7vw, 8rem);

      font-weight: 650;

      line-height: .87;

      letter-spacing: -.07em;

      color: #f2f1ec;
    }


    .dashboard-final-image {
      margin-top:
        clamp(100px, 10vw, 150px);
    }


    .dashboard-final-image img {
      display: block;

      width: 100%;

      aspect-ratio: 16 / 8;

      object-fit: cover;

      background: #151815;
    }


    /* =====================================================
       NEXT ARROW
       same as other editorial case pages
    ====================================================== */

    .case-next__arrow {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 68px;
      height: 68px;

      flex: 0 0 68px;

      border: 2px solid #d8f27a;
      border-radius: 50%;

      color: #d8f27a;

      font-family: Arial, sans-serif;
      font-size: 2.2rem;
      font-weight: 400;
      line-height: 1;

      transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
    }


    .case-next:hover .case-next__arrow {
      background: #d8f27a;

      color: #0d0f0d;

      transform:
        translate(4px,-4px);
    }


    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1000px) {

      .dashboard-section__head {
        grid-template-columns:
          1fr 1.5fr;
      }


      .dashboard-section__head p {
        grid-column: 2;
      }


      .dashboard-grid--3 {
        grid-template-columns:
          1fr 1fr;
      }

    }


    /* =====================================================
       MOBILE
    ====================================================== */

    @media (max-width: 760px) {

      .dashboard-section {
        margin-top: 100px;
      }


      .dashboard-section__head {
        grid-template-columns: 1fr;

        gap: 20px;
      }


      .dashboard-section__head p {
        grid-column: auto;
      }


      .dashboard-grid--2,
      .dashboard-grid--3 {
        grid-template-columns: 1fr;
      }


      .dashboard-card figcaption {
        flex-direction: column;
        align-items: flex-start;

        gap: 5px;
      }


      .dashboard-final {
        grid-template-columns: 1fr;

        gap: 24px;

        margin-top: 110px;
      }


      .dashboard-final p {
        font-size:
          clamp(3rem, 14vw, 5.2rem);
      }


      .case-next__arrow {
        width: 54px;
        height: 54px;

        flex-basis: 54px;

        font-size: 1.8rem;
      }

    }

  </style>

</Base>