<script type="module">
  // Back button: history.back() with fallback
  document.addEventListener('click', (e) => {
    const backBtn = e.target.closest('.action-button--back');
    if (!backBtn) return;
    e.preventDefault();
    if (history.length > 1) history.back();
    else location.assign(backBtn.dataset.fallback || '/');
  });
</script>

